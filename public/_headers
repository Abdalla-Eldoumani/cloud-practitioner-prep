/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# The service worker and its registration shim are served uncached so the
# browser byte-checks them on each load and detects a new deploy promptly.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

/registerSW.js
  Cache-Control: public, max-age=0, must-revalidate

# Correct content-type so the install prompt is not suppressed.
/manifest.webmanifest
  Content-Type: application/manifest+json

# Build assets are content-hashed, so they can be cached forever; a new deploy
# changes the filename and the precache handles the cutover.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
