# script-src keeps 'unsafe-inline' for the site's own inline scripts (theme
# switch, keyboard shortcuts, service-worker registration, framework hydration);
# a single static header cannot carry the per-page hashes the generated scripts
# need, and nothing renders untrusted input as HTML, so there is no sink to
# exploit. Full rationale in docs/SECURITY.md. Keep this policy in sync with vercel.json.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# The service worker is served uncached so the browser byte-checks it on each
# load and detects a new deploy promptly.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

# Correct content-type so the install prompt is not suppressed.
/manifest.webmanifest
  Content-Type: application/manifest+json

# Build assets are content-hashed, so they can be cached forever; a new deploy
# changes the filename and the precache handles the cutover.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
