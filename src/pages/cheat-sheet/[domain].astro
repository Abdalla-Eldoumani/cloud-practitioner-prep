          "Business is the first tier with 24x7 support, unlimited cases, a production-down response target, and full Trusted Advisor checks. A designated Technical Account Manager comes only with Enterprise.",
      },
    ],
  },
};

// One static page per domain id. The param is the domain number as a string.
export function getStaticPaths() {
  return DOMAINS.map((d) => ({ params: { domain: String(d.id) } }));
}

// Validate the param maps to a real domain (1-4) before rendering; an unknown
// value returns a 404 rather than a half-rendered page.
const { domain } = Astro.params;
const domainId = Number(domain) as Domain;
const meta = DOMAINS.find((d) => d.id === domainId);
if (!meta || !SHEETS[domainId]) {
  return new Response(null, { status: 404 });
}
const sheet = SHEETS[domainId];

// Resolve the lesson titles for the "distilled from" footer from the content
// collection, so a renamed lesson surfaces here too. Imported lazily to keep the
// page a pure static render.
const { getCollection } = await import("astro:content");
const lessonEntries = (await getCollection("lessons")).filter(
  (l) => !l.data.draft,
);
const lessonById = new Map(lessonEntries.map((l) => [l.id, l.data.title]));
const sourceLessons = sheet.lessonSlugs.map((slug) => ({
  slug,
  title: lessonById.get(slug) ?? slug,
}));

const prevId = domainId > 1 ? ((domainId - 1) as Domain) : null;
const nextId = domainId < 4 ? ((domainId + 1) as Domain) : null;
---

<BaseLayout
  title={`${domainName(domainId)} cheat sheet`}
  description={`AWS Cloud Practitioner ${domainName(domainId)} cheat sheet (CLF-C02): the key services and facts to review for this exam domain.`}
>
  <p class="print-hide">
    <a href="/cheat-sheet" class="t-mono-sm uppercase transition-colors hover:text-ink-1" style="color: var(--kicker-ink)">
      &larr; All cheat sheets
    </a>
  </p>

  <div class="cheat-sheet mt-4">
    <header class="border-b-[1.5px] border-ink-1 pb-3">
      <div class="flex flex-wrap items-baseline gap-3.5">
        <DomainBadge domain={domainId} showName={false} />
        <span class="min-w-0 flex-1 font-mono text-[11px] tracking-[0.08em] text-ink-1 uppercase">
          CLF-C02 · D{domainId} {meta.name} — {meta.weight}% of the exam
        </span>
        <span class="t-mono-sm flex-none text-ink-3">SHEET {domainId}/4</span>
      </div>
      <p class="t-body-sm mt-3 max-w-2xl text-ink-2">{sheet.intro}</p>
      <div class="print-hide mt-4 flex items-center gap-3">
        <button id="print-cheat-sheet" type="button" class="btn-primary px-4 py-2 text-[13.5px]">
          Print this sheet
        </button>
        <span class="t-mono-sm uppercase text-ink-3">or Ctrl/Cmd + P</span>
      </div>
    </header>

    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        sheet.sections.map((section) => (
          <section class="cheat-card rounded-r3 border border-line-1 bg-ground-1 p-4">
            <h2 class="t-mono-label text-ink-3">{section.heading}</h2>
            <dl class="mt-3 flex flex-col gap-2.5">
              {section.facts.map((fact) => (
                <div>
                  <dt class="t-body-sm font-[640] text-ink-1">{fact.term}</dt>
                  <dd class="t-body-sm text-ink-2">{fact.detail}</dd>
                </div>
              ))}
            </dl>
          </section>
        ))
      }
    </div>

    <section class="mt-8">
      <h2 class="t-title text-[19px] text-ink-1">Tell these apart</h2>
      <ul class="mt-3 flex flex-col gap-3">
        {
          sheet.comparisons.map((c) => (
            <li class="cheat-card rounded-r2 border border-line-1 bg-ground-1 p-4">
              <p class="t-body-sm font-[640] text-ink-1">{c.title}</p>
              <p class="t-body-sm mt-1 text-ink-2">{c.detail}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <footer class="t-body-sm mt-8 border-t-[1.5px] border-ink-1 pt-4 text-ink-3">
      <p>
        Distilled from these lessons:{" "}
        {
          sourceLessons.map((lesson, i) => (
            <>
              {i > 0 && ", "}
              <a
                href={`/learn/${lesson.slug}`}
                class="border-b-2 border-dotted border-line-1 text-ink-2 transition-colors hover:text-ink-1"
              >
                {lesson.title}
              </a>
            </>
          ))
        }.
      </p>
      <p class="mt-2">
        Every fact maps to the{" "}
        <a
          href={EXAM_GUIDE.url}
          target="_blank"
          rel="noopener noreferrer"
          class="border-b-2 border-dotted border-line-1 text-ink-2 transition-colors hover:text-ink-1"
        >
          CLF-C02 exam guide ↗
        </a>{" "}
        and the verified lessons above.
      </p>
    </footer>
  </div>

  <nav
    class="print-hide t-body-sm mt-10 flex justify-between gap-4 border-t border-line-1 pt-6"
    aria-label="Other cheat sheets"
  >
    {
      prevId ? (
        <a href={`/cheat-sheet/${prevId}`} class="border-b-2 border-dotted border-line-1 text-ink-2 transition-colors hover:text-ink-1">
          ← {domainName(prevId)}
        </a>
      ) : (
        <span />
      )
    }
    {
      nextId ? (
        <a href={`/cheat-sheet/${nextId}`} class="border-b-2 border-dotted border-line-1 text-ink-2 transition-colors hover:text-ink-1">
          {domainName(nextId)} →
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</BaseLayout>

<script>
  // The print button just opens the browser print dialog; the print CSS does
  // the rest. Plain inline behavior, no island needed.
  const btn = document.getElementById("print-cheat-sheet");
  if (btn) btn.addEventListener("click", () => window.print());
</script>
