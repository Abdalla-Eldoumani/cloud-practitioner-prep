---
import BaseLayout from "@/layouts/BaseLayout.astro";
import DomainBadge from "@/components/DomainBadge.astro";
import { DOMAINS, domainName } from "@/lib/constants";
import type { Domain, DocReference } from "@/lib/types";

// The per-domain printable cheat sheet. One static page per exam domain (1-4),
// emitted by getStaticPaths so /cheat-sheet/1 .. /cheat-sheet/4 all build. The
// page wraps its body in <div class="cheat-sheet">, the class the print block in
// global.css targets: on paper the site chrome is hidden and this body prints
// in full, ink on white, with cards kept off page breaks.
//
// Content is distilled from the verified lessons listed per domain below (the
// same lessons the coverage map links). Every fact here traces to one of those
// lessons; nothing is authored new. The lessonSlugs are recorded so the
// content-auditor can cross-check each sheet against its sources.

interface Fact {
  term: string; // the concept, service, or model name
  detail: string; // its one-line exam-relevant fact, from the lesson
}

interface Section {
  heading: string;
  facts: Fact[];
}

interface Comparison {
  title: string; // the pair or trio the lessons flag as easily confused
  detail: string; // the distinction that tells them apart
}

interface DomainSheet {
  lessonSlugs: string[]; // the verified lessons this sheet distills (for the auditor)
  intro: string; // one line on what the domain covers
  sections: Section[];
  comparisons: Comparison[]; // the "tell these apart" gotchas the lessons stress
}

// The exam guide, the same DocReference the blueprint uses, on the link-checker's
// AWS-host allowlist. Links each sheet back to the blueprint it summarizes.
