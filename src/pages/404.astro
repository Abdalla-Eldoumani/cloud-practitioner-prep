---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <section class="mx-auto max-w-[560px] py-10">
    <p class="t-mono-sm uppercase" style="color: var(--kicker-ink)">
      404 — no station at this address
    </p>
    <h1 class="t-page mt-4 text-ink-1">Unsurveyed ground.</h1>

    {/* The plot: the mapped chain on the left, a dashed open station off the
        traverse on the right. */}
    <div
      class="substrate relative mt-6 rounded-r3 border border-line-1 bg-ground-1 p-6"
    >
      <svg viewBox="0 0 460 120" class="h-auto w-full" aria-hidden="true">
        <polyline
          points="20,60 96,52 172,64 240,58"
          fill="none"
          stroke="var(--blueprint)"
          stroke-width="1.6"
          stroke-dasharray="0.1 6.5"
          stroke-linecap="round"
          opacity="0.8"></polyline>
        <polyline
          points="240,58 310,70 372,48"
          fill="none"
          stroke="var(--ink-3)"
          stroke-width="1.6"
          stroke-dasharray="0.1 9"
          stroke-linecap="round"
          opacity="0.5"></polyline>
        {
          [
            [20, 60],
            [96, 52],
            [172, 64],
          ].map(([cx, cy]) => (
            <g>
              <circle
                cx={cx}
                cy={cy}
                r="6"
                fill="var(--ground-1)"
                stroke="var(--ink-1)"
                stroke-width="1.6"
              />
              <circle cx={cx} cy={cy} r="2" fill="var(--ink-1)" />
            </g>
          ))
        }
        <circle
          cx="372"
          cy="48"
          r="6"
          fill="none"
          stroke="var(--ink-3)"
          stroke-width="1.5"
          stroke-dasharray="2 3"></circle>
        <text
          x="372"
          y="28"
          text-anchor="middle"
          font-family="Sometype Mono Variable, monospace"
          font-size="9"
          fill="var(--ink-3)">YOU, APPARENTLY</text>
        <text
          x="96"
          y="86"
          text-anchor="middle"
          font-family="Sometype Mono Variable, monospace"
          font-size="9"
          fill="var(--ink-3)">THE MAPPED SITE</text>
      </svg>
    </div>

    <p class="t-body mt-5 text-ink-2">
      This address isn't on the map. The surveyed territory is one link away.
    </p>
    <div class="mt-5 flex flex-wrap gap-3.5">
      <a href="/" class="btn-primary">Home</a>
      <a href="/learn" class="btn-ghost">Learn</a>
      <a href="/practice" class="btn-ghost">Practice</a>
    </div>
  </section>
</BaseLayout>
