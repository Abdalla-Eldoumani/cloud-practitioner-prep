---
import BaseLayout from "@/layouts/BaseLayout.astro";
import QuizEngine from "@/components/quiz/QuizEngine.tsx";
import { ALL_QUESTIONS } from "@/data/questions";
---

<BaseLayout
  title="AWS Cloud Practitioner Mock Exam (CLF-C02)"
  description="A full, timed AWS Cloud Practitioner mock exam (CLF-C02): domain-weighted questions under real exam conditions, scored with a per-domain breakdown."
>
  {/*
    The page's own heading carries exam-hide: while an attempt is live the
    island removes all chrome and the instrument bar owns the top, so this
    header exists only around the gate and the results.
  */}
  <header class="exam-hide mx-auto w-full max-w-[760px]">
    <a
      href="/practice"
      class="t-mono-sm uppercase text-[var(--kicker-ink)] transition-colors hover:text-ink-1"
    >
      &larr; Back to practice
    </a>
    <h1 class="t-page mt-3 text-ink-1">Mock exam</h1>
  </header>

  {/*
    No width constraint or margin here: the island sizes and spaces each phase
    itself (gate and results center on their own measure; the live exam room
    spans the viewport with the instrument bar hard against the top).
  */}
  <QuizEngine client:load pool={ALL_QUESTIONS} mode="exam" />
</BaseLayout>
