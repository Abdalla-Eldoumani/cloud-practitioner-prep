---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ResumeExamBanner from "@/components/quiz/ResumeExamBanner.tsx";
import { DOMAINS, EXAM } from "@/lib/constants";
import { domainTargets } from "@/lib/exam";
import { ALL_QUESTIONS } from "@/data/questions";
import { ALL_SERVICES } from "@/data/services";
import type { Domain } from "@/lib/types";

const counts = new Map<Domain, number>();
for (const d of DOMAINS) counts.set(d.id, 0);
for (const q of ALL_QUESTIONS)
  counts.set(q.domain, (counts.get(q.domain) ?? 0) + 1);

const mins = Math.round(EXAM.timeLimitSeconds / 60);
const targets = domainTargets(EXAM.questionCount);
// The 65-cell sheet: one cell per question of the weighted draw, in exam
// order by domain.
const sheetCells = DOMAINS.flatMap((d) =>
  Array.from({ length: targets[d.id] }, () => d.id),
);
const cardCount = ALL_SERVICES.length;
---

<BaseLayout
  title="AWS Cloud Practitioner Practice Questions & Mock Exam"
  description="Free AWS Cloud Practitioner practice questions (CLF-C02): drill by domain with instant feedback, sit a full timed mock exam, and review what you miss. No signup."
>
  {/* Surfaces a live mock attempt (resume or discard); renders nothing
      otherwise. */}
  <ResumeExamBanner client:load />

  <header>
    <p class="t-mono-sm uppercase" style="color: var(--kicker-ink)">
      Practice · {ALL_QUESTIONS.length} original questions
    </p>
    <h1 class="t-page mt-3 text-ink-1">Practice</h1>
  </header>

  {/* The marquee: the page's one instrument. The mock is what the week
      points at. */}
  <div
    class="substrate relative mt-7 flex flex-col gap-8 rounded-r3 border border-line-1 bg-ground-1 px-5 py-6 sm:px-9 sm:py-8 lg:flex-row lg:gap-10"
  >
    <span
      aria-hidden="true"
      class="absolute -top-px -left-px size-3.5 border-t-2 border-l-2 border-blueprint"
    ></span>
    <span
      aria-hidden="true"
      class="absolute -top-px -right-px size-3.5 border-t-2 border-r-2 border-blueprint"
    ></span>
    <span
      aria-hidden="true"
      class="absolute -bottom-px -left-px size-3.5 border-b-2 border-l-2 border-blueprint"
    ></span>
    <span
      aria-hidden="true"
      class="absolute -bottom-px -right-px size-3.5 border-b-2 border-r-2 border-blueprint"
    ></span>

    <div class="flex-[1.2]">
      <div class="flex items-center gap-3">
        <svg width="17" height="17" viewBox="0 0 18 18" aria-hidden="true">
          <polygon
            points="9,2 16.5,15.5 1.5,15.5"
            fill="none"
            stroke="var(--flag)"
            stroke-width="1.6"
            stroke-linejoin="round"></polygon>
          <circle cx="9" cy="12" r="1.7" fill="var(--flag)"></circle>
        </svg>
        <span
          class="font-mono text-[10.5px] tracking-[0.16em]"
          style="color: var(--flag)">BENCHMARK</span
        >
      </div>
      <h2 class="t-title mt-3.5 text-ink-1">The full mock exam</h2>
      <p
        class="t-body mt-3 max-w-[460px] text-ink-2"
        style="text-wrap: pretty"
      >
        {EXAM.questionCount} questions, {mins} minutes, timed, auto-submitted —
        weighted like the real blueprint. The only honest answer to "am I
        ready?"
      </p>
      <p
        class="t-mono-sm mt-5 flex flex-wrap gap-x-2 uppercase text-ink-3"
      >
        <span>{EXAM.questionCount} questions</span>
        <span aria-hidden="true">·</span>
        <span>{mins} minutes</span>
        <span aria-hidden="true">·</span>
        <span>Auto-submit at 0:00</span>
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a href="/practice/exam" class="btn-primary px-6 py-3">
          Begin the mock
        </a>
        <span class="t-mono-sm uppercase text-ink-3" data-mock-record>
          No attempts yet
        </span>
      </div>
    </div>

    <div class="flex max-w-[420px] flex-1 flex-col gap-2.5">
      <p class="t-mono-label" style="color: var(--kicker-ink)">
        The sheet — {EXAM.questionCount} marks, weighted like the exam
      </p>
      <div
        class="flex flex-wrap gap-1"
        role="img"
        aria-label={`The mock draws ${DOMAINS.map((d) => `${targets[d.id]} from ${d.name}`).join(", ")}`}
      >
        {
          sheetCells.map((id) => (
            <span
              class="box-border block h-3 w-[26px] rounded-[2px] border"
              style={`background: color-mix(in srgb, var(--d${id}) 30%, transparent); border-color: color-mix(in srgb, var(--d${id}) 65%, transparent)`}
            />
          ))
        }
      </div>
      <p class="flex flex-wrap gap-x-3.5 font-mono text-[9px] text-ink-3">
        {
          DOMAINS.map((d) => (
            <span class="inline-flex items-center gap-1.5">
              <span
                class="box-border inline-block h-[7px] w-3 rounded-[2px] border"
                style={`background: color-mix(in srgb, var(--d${d.id}) 30%, transparent); border-color: color-mix(in srgb, var(--d${d.id}) 65%, transparent)`}
              />
              D{d.id} ×{targets[d.id]}
            </span>
          ))
        }
      </p>
    </div>
  </div>

  <div class="mt-11 grid gap-12 lg:grid-cols-[1.35fr_1fr]">
    {/* The daily driver: domain drill rows. */}
    <section>
      <div class="flex items-center gap-3">
        <svg width="15" height="15" viewBox="0 0 15 15" aria-hidden="true">
          <circle
            cx="7.5"
            cy="7.5"
            r="5.6"
            fill="none"
            stroke="var(--blueprint)"
            stroke-width="1.5"></circle>
          <circle cx="7.5" cy="7.5" r="2" fill="var(--blueprint)"></circle>
        </svg>
        <span
          class="font-mono text-[11px] tracking-[0.18em]"
          style="color: var(--kicker-ink)">§01</span
        >
        <h2 class="t-title text-[21px] text-ink-1">
          Domain drills — the daily driver
        </h2>
      </div>
      <div
        class="mt-4 overflow-hidden rounded-r3 border border-line-1 bg-ground-1"
      >
        {
          DOMAINS.map((d) => (
            <a
              href={`/practice/${d.id}`}
              class="flex items-center gap-4 border-b border-line-1 px-4 py-4 transition-colors last:border-b-0 hover:bg-ground-2 sm:px-5"
            >
              <span
                class="t-mono-sm w-7 flex-none"
                style={`color: var(--d${d.id})`}
              >
                D{d.id}
              </span>
              <span class="min-w-0 flex-1">
                <span class="t-sub block text-ink-1">{d.name}</span>
                <span class="mt-0.5 block font-mono text-[10.5px] text-ink-3">
                  {counts.get(d.id)} QUESTIONS · {d.weight}% OF THE EXAM
                </span>
              </span>
              <span class="btn-secondary flex-none px-4 py-2 text-[13px]">
                Drill 10 &rarr;
              </span>
            </a>
          ))
        }
      </div>
    </section>

    {/* Support: T3 rows on the ground. */}
    <section>
      <div class="flex items-center gap-3">
        <svg width="15" height="15" viewBox="0 0 15 15" aria-hidden="true">
          <circle
            cx="7.5"
            cy="7.5"
            r="5.6"
            fill="none"
            stroke="var(--blueprint)"
            stroke-width="1.5"></circle>
          <circle cx="7.5" cy="7.5" r="2" fill="var(--blueprint)"></circle>
        </svg>
        <span
          class="font-mono text-[11px] tracking-[0.18em]"
          style="color: var(--kicker-ink)">§02</span
        >
        <h2 class="t-title text-[21px] text-ink-1">Support</h2>
      </div>
      <div class="mt-2 flex flex-col">
        <a
          href="/practice/review"
          class="flex min-h-12 items-center gap-3.5 border-b border-line-1 px-1 py-3.5 transition-colors hover:bg-ground-1"
        >
          <span class="text-[15px] font-[600] text-ink-1">Review queue</span>
          <span
            class="t-mono-sm ml-auto uppercase text-ink-3"
            data-review-count>Collects your misses</span
          >
          <span aria-hidden="true" class="text-ink-3">&rarr;</span>
        </a>
        <a
          href="/practice/drill"
          class="flex min-h-12 items-center gap-3.5 border-b border-line-1 px-1 py-3.5 transition-colors hover:bg-ground-1"
        >
          <span class="text-[15px] font-[600] text-ink-1">Weak-area drill</span>
          <span class="t-mono-sm ml-auto uppercase text-ink-3"
            >Built from your misses</span
          >
          <span aria-hidden="true" class="text-ink-3">&rarr;</span>
        </a>
        <a
          href="/practice/flashcards"
          class="flex min-h-12 items-center gap-3.5 border-b border-line-1 px-1 py-3.5 transition-colors hover:bg-ground-1"
        >
          <span class="text-[15px] font-[600] text-ink-1">Flashcards</span>
          <span class="t-mono-sm ml-auto uppercase text-ink-3" data-card-count
            >{cardCount} cards</span
          >
          <span aria-hidden="true" class="text-ink-3">&rarr;</span>
        </a>
        <a
          href="/coverage"
          class="flex min-h-12 items-center gap-3.5 border-b border-line-1 px-1 py-3.5 transition-colors hover:bg-ground-1"
        >
          <span class="text-[15px] font-[600] text-ink-1">Coverage map</span>
          <span
            class="t-mono-sm ml-auto uppercase"
            style="color: var(--ok)">19/19 covered</span
          >
          <span aria-hidden="true" class="text-ink-3">&rarr;</span>
        </a>
        <a
          href="/cheat-sheet"
          class="flex min-h-12 items-center gap-3.5 border-b border-line-1 px-1 py-3.5 transition-colors hover:bg-ground-1"
        >
          <span class="text-[15px] font-[600] text-ink-1">Cheat sheets</span>
          <span class="t-mono-sm ml-auto uppercase text-ink-3"
            >4 · print-ready</span
          >
          <span aria-hidden="true" class="text-ink-3">&rarr;</span>
        </a>
        <a
          href="/exam-day"
          class="flex min-h-12 items-center gap-3.5 px-1 py-3.5 transition-colors hover:bg-ground-1"
        >
          <span class="text-[15px] font-[600] text-ink-1"
            >Exam-day checklist</span
          >
          <span class="t-mono-sm ml-auto uppercase text-ink-3">Go / no-go</span>
          <span aria-hidden="true" class="text-ink-3">&rarr;</span>
        </a>
      </div>
    </section>
  </div>

  {/* Honest numbers from saved progress: the mock record line and the
      review-queue count. Without JS or history, the server copy stands. */}
  <script is:inline>
    (function () {
      try {
        var raw = localStorage.getItem("ccp-prep:progress:v1");
        if (!raw) return;
        var p = JSON.parse(raw);
        var mocks = (p.attempts || []).filter(function (a) {
          return a.mode === "exam";
        });
        if (mocks.length > 0) {
          var best = Math.max.apply(
            null,
            mocks.map(function (a) {
              return a.percent;
            }),
          );
          var last = mocks[0].percent;
          var band =
            last >= 85
              ? "EXAM READY"
              : last >= 75
                ? "ON TRACK"
                : last >= 60
                  ? "BUILDING"
                  : "NOT READY";
          var el = document.querySelector("[data-mock-record]");
          if (el) {
            el.textContent =
              "BEST " +
              best +
              "% · " +
              mocks.length +
              (mocks.length === 1 ? " ATTEMPT" : " ATTEMPTS") +
              " · LAST: " +
              band;
          }
        }
        var queue = new Set(
          (p.flaggedQuestions || []).concat(p.incorrectQuestions || []),
        ).size;
        var q = document.querySelector("[data-review-count]");
        if (q && queue > 0) {
          q.textContent = queue + " UNFIXED";
          q.style.color = "var(--flag)";
        }
      } catch (e) {}
    })();
  </script>
</BaseLayout>
