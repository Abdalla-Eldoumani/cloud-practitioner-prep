---
import BaseLayout from "@/layouts/BaseLayout.astro";
import QuizEngine from "@/components/quiz/QuizEngine.tsx";
import { DOMAINS, domainName } from "@/lib/constants";
import { ALL_QUESTIONS } from "@/data/questions";
import type { Domain } from "@/lib/types";

export function getStaticPaths() {
  return DOMAINS.map((d) => ({ params: { domain: String(d.id) } }));
}

const { domain } = Astro.params;
const domainId = Number(domain) as Domain;
const name = domainName(domainId);
// A domain practice page only needs its own domain's questions. Filtering here
// keeps the island's serialized prop small instead of shipping the full pool.
const domainQuestions = ALL_QUESTIONS.filter((q) => q.domain === domainId);
const available = domainQuestions.length;
const count = Math.min(10, available);
---

<BaseLayout
  title={`Practice: ${name}`}
  description={`Free AWS Cloud Practitioner practice questions on ${name} (CLF-C02), with instant feedback and an explanation for every answer.`}
>
  <header class="mx-auto max-w-2xl">
    <a
      href="/practice"
      class="t-mono-sm uppercase transition-colors hover:text-ink-1" style="color: var(--kicker-ink)"
    >
      Back to practice
    </a>
    <h1 class="t-page mt-3 text-ink-1">
      Practice: {name}
    </h1>
    <p class="t-body mt-2 text-ink-2">
      {count} questions with instant feedback. Flag any you want to revisit.
    </p>
  </header>

  <div class="mx-auto mt-8 max-w-2xl">
    <QuizEngine
      client:load
      pool={domainQuestions}
      mode="practice"
      domain={domainId}
      count={count}
    />
  </div>
</BaseLayout>
