---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Flashcards from "@/components/quiz/Flashcards.tsx";
import { ALL_SERVICES } from "@/data/services";
import { ALL_QUESTIONS } from "@/data/questions";

// The deck is assembled in the browser: the island reads the learner's missed
// ids from $progress at mount and resolves them against the pool, so the page
// ships the verified catalog and the full question pool as serialized props and
// lets the island build and shuffle the deck. The catalog always yields cards
// (113 services), so the empty state is effectively only reachable if both
// sources were emptied.
---

<BaseLayout
  title="AWS Cloud Practitioner Flashcards (CLF-C02)"
  description="Free AWS Cloud Practitioner flashcards (CLF-C02): self-graded recall over the service catalog and the questions you have missed."
>
  <header class="mx-auto max-w-2xl">
    <a
      href="/practice"
      class="t-mono-sm uppercase transition-colors hover:text-ink-1" style="color: var(--kicker-ink)"
    >
      Back to practice
    </a>
    <h1 class="t-page mt-3 text-ink-1">
      Flashcards
    </h1>
    <p class="t-body mt-2 text-ink-2">
      Quick recall from the service catalog and the questions you missed. Flip
      each card, then mark whether you knew it. Works fully by keyboard.
    </p>
  </header>

  <div class="mx-auto mt-8 max-w-2xl">
    <Flashcards client:load services={ALL_SERVICES} pool={ALL_QUESTIONS} />
  </div>
</BaseLayout>
