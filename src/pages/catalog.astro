---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CatalogBrowser from "@/components/catalog/CatalogBrowser.tsx";
import CompareCard from "@/components/catalog/CompareCard.astro";
import { ALL_SERVICES } from "@/data/services";
import { COMPARE_GROUPS } from "@/data/services/compare";

// The compare section is server-rendered and static. It only appears when there
// are groups to show; both the jump list and the cards guard the empty case so
// the page stays clean while the compare content is still being authored.
const hasCompare = COMPARE_GROUPS.length > 0;
---

<BaseLayout title="Service catalog">
  <header class="max-w-2xl">
    <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
      Service catalog
    </h1>
    <p class="mt-3 text-lg text-ink-soft">
      Every AWS service the Cloud Practitioner exam can ask about, with what it
      is, when to reach for it, and a link to the official docs. Search by name
      or filter by exam domain.
    </p>
  </header>

  {
    hasCompare && (
      <section class="mt-12">
        <h2 class="text-xl font-bold text-ink">Tell similar services apart</h2>
        <p class="mt-1 text-ink-soft">
          The pairs and trios that are easiest to confuse, side by side.
        </p>
        <nav aria-label="Jump to comparisons" class="mt-4">
          <p class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
            <span class="text-ink-soft">Jump to:</span>
            {COMPARE_GROUPS.map((g) => (
              <a
                href={`#${g.id}`}
                class="text-brand underline underline-offset-2"
              >
                {g.title}
              </a>
            ))}
          </p>
        </nav>
        <div class="mt-6 flex flex-col gap-6">
          {COMPARE_GROUPS.map((g) => (
            <CompareCard group={g} />
          ))}
        </div>
      </section>
    )
  }

  <section class="mt-12">
    <h2 class="text-xl font-bold text-ink">Browse all services</h2>
    <div class="mt-6">
      <CatalogBrowser client:load services={ALL_SERVICES} />
    </div>
  </section>
</BaseLayout>
