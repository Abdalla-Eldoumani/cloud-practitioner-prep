---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CatalogBrowser from "@/components/catalog/CatalogBrowser.tsx";
import CompareCard from "@/components/catalog/CompareCard.astro";
import { ALL_SERVICES } from "@/data/services";
import { COMPARE_GROUPS } from "@/data/services/compare";

// The compare section is server-rendered and static. It only appears when there
// are groups to show; both the jump list and the cards guard the empty case so
// the page stays clean while the compare content is still being authored.
const hasCompare = COMPARE_GROUPS.length > 0;

// Security group vs Network ACL is the one comparison that cannot be a
// COMPARE_GROUPS card: both are VPC features, not standalone catalog services,
// so neither has a ServiceEntry id to key on. It ships here as a static table
// keyed on plain concept labels, using the same four fixed attribute rows and
// the same stacked-on-mobile / side-by-side-from-sm reflow as CompareCard, so
// the comparison renders without forcing an off-manifest entry or a lint
// exception. It is appended to the compare section and the jump list below.
const sgNaclId = "security-group-vs-network-acl";
const sgNaclTitle = "Security group vs Network ACL";
const sgNaclFraming =
  "two VPC firewalls at different levels — a stateful one on the instance and a stateless one on the subnet.";
const sgNaclColumns = [
  { key: "security-group", name: "Security group" },
  { key: "network-acl", name: "Network ACL" },
] as const;
const sgNaclRows: { axis: string; cells: Record<string, string> }[] = [
  {
    axis: "What it is",
    cells: {
      "security-group":
        "A virtual firewall at the instance level (attached to an ENI), evaluating allow rules only.",
      "network-acl":
        "A firewall at the subnet level that evaluates allow and deny rules for traffic entering or leaving the subnet.",
    },
  },
  {
    axis: "You manage",
    cells: {
      "security-group":
        "Inbound and outbound allow rules; return traffic is allowed automatically because it is stateful.",
      "network-acl":
        "Numbered inbound and outbound rules, allow or deny; you must allow return traffic too because it is stateless.",
    },
  },
  {
    axis: "Best for",
    cells: {
      "security-group":
        "The everyday control of what can reach a specific instance or resource.",
      "network-acl":
        "A broad, coarse guardrail across a whole subnet, such as blocking a range of addresses.",
    },
  },
  {
    axis: "Watch out for",
    cells: {
      "security-group":
        "It is stateful and allow-only; you cannot write an explicit deny rule in it.",
      "network-acl":
        "It is stateless: forgetting the matching outbound (or inbound) rule silently breaks the return path.",
    },
  },
];
const sgNaclReference = {
  label: "Security in your VPC (security groups and network ACLs)",
  url: "https://docs.aws.amazon.com/vpc/latest/userguide/vpc-security.html",
};
---

<BaseLayout
  title="AWS Service Catalog for the Cloud Practitioner Exam"
  description="Every AWS service the Cloud Practitioner (CLF-C02) exam can ask about, with what it does, when to use it, and a link to the official AWS documentation."
>
  <header class="max-w-2xl">
    <p class="t-mono-sm uppercase" style="color: var(--kicker-ink)">
      Catalog · the services, in plain words
    </p>
    <h1 class="t-page mt-3 text-ink-1">
      Service catalog
    </h1>
    <p class="t-body-lg mt-3 text-ink-2">
      Every AWS service the Cloud Practitioner exam can ask about, with what it
      is, when to reach for it, and a link to the official docs. Search by name
      or filter by exam domain.
    </p>
  </header>

  {
    hasCompare && (
      <section class="mt-12">
        <h2 class="t-title text-[21px] text-ink-1">Tell similar services apart</h2>
        <p class="t-body-sm mt-1.5 text-ink-2">
          The pairs and trios that are easiest to confuse, side by side.
        </p>
        <nav aria-label="Jump to comparisons" class="mt-4">
          <p class="t-body-sm flex flex-wrap items-center gap-x-4 gap-y-1">
            <span class="text-ink-3">Jump to:</span>
            {COMPARE_GROUPS.map((g) => (
              <a
                href={`#${g.id}`}
                class="border-b-2 border-dotted border-line-1 text-ink-2 transition-colors hover:text-ink-1"
              >
                {g.title}
              </a>
            ))}
            <a
              href={`#${sgNaclId}`}
              class="border-b-2 border-dotted border-line-1 text-ink-2 transition-colors hover:text-ink-1"
            >
              {sgNaclTitle}
            </a>
          </p>
        </nav>
        <div class="mt-6 flex flex-col gap-6">
          {COMPARE_GROUPS.map((g) => (
            <CompareCard group={g} />
          ))}

          {/*
            Security group vs Network ACL: a static card (these are VPC
            features, not catalog services, so they are not in COMPARE_GROUPS).
            Same four fixed rows and the same stacked-on-mobile / table-from-sm
            reflow as CompareCard, keyed on plain concept labels.
          */}
          <div
            id={sgNaclId}
            class="relative scroll-mt-8 rounded-r3 border border-line-1 bg-ground-1 p-4 sm:p-5"
          >
            <span aria-hidden="true" class="absolute -top-px -left-px size-3 border-t-2 border-l-2 border-blueprint"></span>
            <span aria-hidden="true" class="absolute -top-px -right-px size-3 border-t-2 border-r-2 border-blueprint"></span>
            <span aria-hidden="true" class="absolute -bottom-px -left-px size-3 border-b-2 border-l-2 border-blueprint"></span>
            <span aria-hidden="true" class="absolute -bottom-px -right-px size-3 border-b-2 border-r-2 border-blueprint"></span>
            <div class="flex flex-wrap items-center gap-2.5">
              <h3 class="t-mono-label" style="color: var(--kicker-ink)">
                Don't confuse — {sgNaclTitle}
              </h3>
              <span
                class="ml-auto rounded-r1 border px-2 py-0.5 font-mono text-[9px] tracking-[0.12em] whitespace-nowrap"
                style="color: var(--flag); border-color: var(--flag-line)"
              >
                EXAM FAVORITE
              </span>
            </div>
            <p class="t-body-sm mt-1.5 text-ink-2">{sgNaclFraming}</p>

            <div class="mt-3.5 overflow-x-auto rounded-r2 border border-line-1">
              <table class="w-full min-w-[560px] border-collapse text-left">
                <thead>
                  <tr class="border-b border-line-1">
                    <th scope="col" class="sticky left-0 bg-ground-1 p-3 align-bottom">
                      <span class="sr-only">Attribute</span>
                    </th>
                    {sgNaclColumns.map((col) => (
                      <th scope="col" class="p-3 align-bottom">
                        <span class="font-mono text-[12px] font-[560] text-ink-1">{col.name}</span>
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {sgNaclRows.map((row) => (
                    <tr class="border-b border-line-1 last:border-0">
                      <th
                        scope="row"
                        class="sticky left-0 bg-ground-1 p-3 align-top font-mono text-[10px] tracking-[0.12em] text-ink-3 uppercase"
                      >
                        {row.axis}
                      </th>
                      {sgNaclColumns.map((col) => (
                        <td class="t-body-sm p-3 align-top text-ink-2">
                          {row.cells[col.key]}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <p class="mt-3.5">
              <a
                href={sgNaclReference.url}
                target="_blank"
                rel="noopener noreferrer"
                class="t-mono-sm uppercase transition-colors hover:text-ink-1"
                style="color: var(--kicker-ink)"
              >
                {sgNaclReference.label} &#8599;
              </a>
            </p>
          </div>
        </div>
      </section>
    )
  }

  <section class="mt-12">
    <h2 class="t-title text-[21px] text-ink-1">Browse all services</h2>
    <div class="mt-6">
      <CatalogBrowser client:load services={ALL_SERVICES} />
    </div>
  </section>
</BaseLayout>
