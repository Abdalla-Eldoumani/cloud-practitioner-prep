---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { DOMAINS } from "@/lib/constants";
import type { Domain } from "@/lib/types";

const entries = (await getCollection("lessons")).filter((l) => !l.data.draft);

// Group lessons under their domain and order them within each group.
const byDomain = DOMAINS.map((d) => ({
  meta: d,
  lessons: entries
    .filter((l) => l.data.domain === (d.id as Domain))
    .sort((a, b) => a.data.order - b.data.order),
}));

const total = entries.length;

// Course structured data that ties the lessons together; each lesson points
// back to this @id via its own isPartOf. The workload is the summed lesson
// estimates, rounded to whole hours.
const siteUrl = Astro.site?.href ?? `${Astro.url.origin}/`;
const totalMinutes = entries.reduce(
  (sum, l) => sum + (l.data.estimatedMinutes ?? 0),
  0,
);
const courseJsonLd = {
  "@context": "https://schema.org",
  "@type": "Course",
  "@id": `${siteUrl}learn/#course`,
  name: "AWS Certified Cloud Practitioner (CLF-C02) Study Course",
  description:
    "A free, beginner-friendly course covering every domain of the AWS Certified Cloud Practitioner (CLF-C02) exam.",
  url: `${siteUrl}learn/`,
  inLanguage: "en",
  isAccessibleForFree: true,
  about: [
    "AWS",
    "Cloud computing",
    "AWS Certified Cloud Practitioner",
    "CLF-C02",
  ],
  provider: {
    "@type": "Organization",
    name: "Cloud Practitioner Prep",
    "@id": `${siteUrl}#org`,
  },
  offers: {
    "@type": "Offer",
    category: "Free",
    price: 0,
    priceCurrency: "USD",
  },
  hasCourseInstance: {
    "@type": "CourseInstance",
    courseMode: "online",
    courseWorkload: `PT${Math.max(1, Math.round(totalMinutes / 60))}H`,
  },
};

const GLYPHS: Record<number, "circle" | "diamond" | "triangle" | "square"> = {
  1: "circle",
  2: "diamond",
  3: "triangle",
  4: "square",
};
---

<BaseLayout
  title="AWS Cloud Practitioner Lessons (CLF-C02)"
  description="Free AWS Cloud Practitioner lessons covering every CLF-C02 exam domain, written for beginners and verified against official AWS documentation."
  jsonLd={courseJsonLd}
>
  <header class="max-w-2xl">
    <p class="t-mono-sm uppercase" style="color: var(--kicker-ink)">
      Learn · {total} lessons · four domains
    </p>
    <h1 class="t-page mt-3 text-ink-1">Lessons</h1>
    <p class="t-body-lg mt-3 text-ink-2">
      Every topic on the exam, organized by domain. Work top to bottom, or
      follow the seven-day plan on the home page. A fixed station stays fixed.
    </p>
  </header>

  <div class="mt-10 flex flex-col gap-12">
    {
      byDomain.map((group) => (
        <section>
          <div class="flex flex-wrap items-center gap-3 border-t border-line-1 pt-7">
            <svg width="13" height="13" viewBox="0 0 11 11" aria-hidden="true">
              {GLYPHS[group.meta.id] === "circle" && (
                <circle
                  cx="5.5"
                  cy="5.5"
                  r="4.2"
                  fill="none"
                  stroke={`var(--d${group.meta.id})`}
                  stroke-width="1.6"
                />
              )}
              {GLYPHS[group.meta.id] === "diamond" && (
                <rect
                  x="2.4"
                  y="2.4"
                  width="6.2"
                  height="6.2"
                  fill="none"
                  stroke={`var(--d${group.meta.id})`}
                  stroke-width="1.6"
                  transform="rotate(45 5.5 5.5)"
                />
              )}
              {GLYPHS[group.meta.id] === "triangle" && (
                <polygon
                  points="2,2.6 9,2.6 5.5,9"
                  fill="none"
                  stroke={`var(--d${group.meta.id})`}
                  stroke-width="1.6"
                  stroke-linejoin="round"
                />
              )}
              {GLYPHS[group.meta.id] === "square" && (
                <rect
                  x="2.2"
                  y="2.2"
                  width="6.6"
                  height="6.6"
                  fill="none"
                  stroke={`var(--d${group.meta.id})`}
                  stroke-width="1.6"
                />
              )}
            </svg>
            <span
              class="font-mono text-[10.5px]"
              style={`color: var(--d${group.meta.id})`}
            >
              D{group.meta.id}
            </span>
            <h2 class="t-title text-ink-1">{group.meta.name}</h2>
            <span class="t-mono-sm ml-auto uppercase text-ink-3">
              {group.meta.weight}% of the exam ·{" "}
              {group.lessons.length}{" "}
              {group.lessons.length === 1 ? "lesson" : "lessons"}
            </span>
          </div>

          {group.lessons.length === 0 ? (
            <p class="t-body mt-4 text-ink-2">
              Lessons for this domain are being written.
            </p>
          ) : (
            <div class="relative mt-5">
              <div
                aria-hidden="true"
                class="absolute top-5 bottom-5 left-[9px] border-l-2 border-dotted"
                style="border-color: color-mix(in srgb, var(--blueprint) 40%, transparent)"
              />
              <ul class="flex flex-col">
                {group.lessons.map((l) => (
                  <li data-lesson={l.id} data-state="open">
                    <a
                      href={`/learn/${l.id}`}
                      class="group flex items-start gap-4 rounded-r2 px-1 py-3 transition-colors hover:bg-ground-1"
                    >
                      <span class="relative z-[1] mt-0.5 flex size-[19px] flex-none items-center justify-center bg-ground-0">
                        <svg
                          width="19"
                          height="19"
                          viewBox="0 0 18 18"
                          aria-hidden="true"
                        >
                          <circle
                            cx="9"
                            cy="9"
                            r="6.6"
                            fill="var(--ground-0)"
                            stroke="var(--ink-3)"
                            stroke-width="1.6"
                          />
                          <circle
                            data-when="done"
                            cx="9"
                            cy="9"
                            r="2.3"
                            fill="var(--ink-1)"
                          />
                        </svg>
                      </span>
                      <span class="min-w-0 flex-1">
                        <span class="t-sub block text-ink-1 transition-colors group-hover:text-blueprint-strong">
                          {l.data.title}
                        </span>
                        <span class="t-body-sm mt-0.5 block text-ink-2">
                          {l.data.description}
                        </span>
                      </span>
                      <span class="t-mono-sm mt-1 flex-none text-ink-3">
                        {l.data.estimatedMinutes} MIN
                      </span>
                      <span
                        data-when="done"
                        class="mt-1 flex-none font-mono text-[10px] tracking-[0.14em]"
                        style="color: var(--ok)"
                      >
                        ✓
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>
      ))
    }
  </div>

  {/* Mark completed lessons as fixed stations from saved progress. */}
  <script is:inline>
    (function () {
      try {
        var raw = localStorage.getItem("ccp-prep:progress:v1");
        if (!raw) return;
        var done = new Set(JSON.parse(raw).completedLessons || []);
        document.querySelectorAll("[data-lesson]").forEach(function (el) {
          if (done.has(el.getAttribute("data-lesson"))) {
            el.setAttribute("data-state", "done");
          }
        });
      } catch (e) {}
    })();
  </script>
</BaseLayout>
