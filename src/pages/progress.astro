---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProgressDashboard from "@/components/ProgressDashboard.tsx";

const totalLessons = (await getCollection("lessons")).filter(
  (l) => !l.data.draft,
).length;
---

<BaseLayout title="Your progress">
  <header class="max-w-2xl">
    <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
      Your progress
    </h1>
    <p class="mt-3 text-lg text-ink-soft">
      Lessons completed, mock scores over time, and the questions waiting in your
      review queue. Everything here is saved on this device only.
    </p>
  </header>

  <div class="mt-8">
    <ProgressDashboard client:load totalLessons={totalLessons} />
  </div>
</BaseLayout>
