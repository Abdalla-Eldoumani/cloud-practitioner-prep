---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProgressDashboard from "@/components/ProgressDashboard.tsx";
import ProgressIO from "@/components/ProgressIO.tsx";
import { ALL_QUESTIONS } from "@/data/questions";

const totalLessons = (await getCollection("lessons")).filter(
  (l) => !l.data.draft,
).length;
---

<BaseLayout
  title="Your progress"
  description="Track your AWS Cloud Practitioner (CLF-C02) readiness: per-domain scores, your mock exam trend, and a conservative ready or not-yet signal. Saved on your device."
>
  <header
    class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between"
  >
    <div>
      <p class="t-mono-sm uppercase" style="color: var(--kicker-ink)">
        Progress · stored in this browser
      </p>
      <h1 class="t-page mt-3 text-ink-1">Progress</h1>
    </div>
    {/* Export / import / clear: progress is a file the learner owns. */}
    <ProgressIO client:load />
  </header>

  <div class="mt-7">
    <ProgressDashboard
      client:load
      totalLessons={totalLessons}
      pool={ALL_QUESTIONS.map((q) => ({ topic: q.topic, domain: q.domain }))}
    />
  </div>

  <div class="mt-6 border-l-[3px] border-blueprint py-1 pl-[18px]">
    <p class="t-body-sm max-w-[680px] text-ink-3">
      The readiness band is this site's own study signal, not the AWS scaled
      score.
      <a
        href="/exam-day"
        class="underline underline-offset-2 transition-colors hover:text-ink-1"
      >
        See how AWS actually scores the real exam &rarr;
      </a>
    </p>
  </div>
</BaseLayout>
