---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProgressDashboard from "@/components/ProgressDashboard.tsx";
import ProgressIO from "@/components/ProgressIO.tsx";
import { ALL_QUESTIONS } from "@/data/questions";

const totalLessons = (await getCollection("lessons")).filter(
  (l) => !l.data.draft,
).length;
---

<BaseLayout
  title="Your progress"
  description="Track your AWS Cloud Practitioner (CLF-C02) readiness: per-domain scores, your mock exam trend, and a conservative ready or not-yet signal. Saved on your device."
>
  <header class="max-w-2xl">
    <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
      Your progress
    </h1>
    <p class="mt-3 text-lg text-ink-soft">
      Lessons completed, mock scores over time, and the questions waiting in your
      review queue. Everything here is saved on this device only.
    </p>
  </header>

  <div class="mt-8">
    <ProgressDashboard
      client:load
      totalLessons={totalLessons}
      pool={ALL_QUESTIONS.map((q) => ({ topic: q.topic, domain: q.domain }))}
    />
  </div>

  <p class="mt-6 text-sm text-ink-soft">
    The readiness band above is this site's own study signal, not the AWS scaled
    score.{" "}
    <a href="/exam-day" class="font-medium text-brand underline underline-offset-2">
      See how AWS actually scores the real exam →
    </a>
  </p>

  <div class="mt-6">
    <ProgressIO client:load />
  </div>
</BaseLayout>
