---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import DomainBadge from "@/components/DomainBadge.astro";
import { TASK_STATEMENTS } from "@/data/blueprint";
import { ALL_QUESTIONS } from "@/data/questions";
import { normalizeTopic } from "@/lib/topics";
import { DOMAINS } from "@/lib/constants";
import type { Domain } from "@/lib/types";

// The blueprint coverage map: every CLF-C02 task statement linked to the lessons
// and questions that cover it. This is a pure build-time render of the verified
// TASK_STATEMENTS join (no client state). The completeness lint hard-fails if any
// statement resolves to zero covering lessons or questions, so every statement
// shown here is genuinely covered — the map is honest by construction, not a
// vacuous "all green".

// Resolve lesson slugs against the live content collection (skip drafts), so a
// covering-lesson link only renders for a lesson that actually exists. Keyed by
// the entry id, which is the slug used in the /learn/<slug> route.
const lessonEntries = (await getCollection("lessons")).filter(
  (l) => !l.data.draft,
);
const lessonById = new Map(lessonEntries.map((l) => [l.id, l]));

// One rendered statement: its verbatim title, the covering lessons that resolve
// to a live entry, the count of covering questions, the topic tags, and the
// exam-guide reference. Questions resolve exactly as the lint does — same
// domain, topic matched through normalizeTopic — so the page cannot fork from it.
const statements = TASK_STATEMENTS.map((ts) => {
  const topicSet = new Set(ts.topics.map(normalizeTopic));
  const questionCount = ALL_QUESTIONS.filter(
    (q) => q.domain === ts.domain && topicSet.has(normalizeTopic(q.topic)),
  ).length;
  // Drop a slug with no live lesson defensively, though the lint guarantees each
  // resolves; keep the title for the link text.
  const lessons = ts.lessonSlugs
    .map((slug) => {
      const entry = lessonById.get(slug);
      return entry ? { slug, title: entry.data.title } : null;
    })
    .filter((l): l is { slug: string; title: string } => l !== null);
  return { ...ts, lessons, questionCount };
});

// Group the statements under the four exam domains, in guide order, so each
// section carries the domain name and weight the same way the lessons and
// practice pages do.
const byDomain = DOMAINS.map((meta) => ({
  meta,
  statements: statements.filter((s) => s.domain === (meta.id as Domain)),
}));

const totalStatements = TASK_STATEMENTS.length;

// The footer figure counts what this page actually maps, not the size of the
// bank: distinct questions that resolve to at least one task statement, matched
// exactly as the per-statement counts above (same domain, topic through
// normalizeTopic). Deduplicated by question id, so a question that answers to
// two statements is counted once and the number cannot overstate the join.
const mappedQuestionIds = new Set<string>();
for (const ts of TASK_STATEMENTS) {
  const topicSet = new Set(ts.topics.map(normalizeTopic));
  for (const q of ALL_QUESTIONS) {
    if (q.domain === ts.domain && topicSet.has(normalizeTopic(q.topic))) {
      mappedQuestionIds.add(q.id);
    }
  }
}
const mappedQuestions = mappedQuestionIds.size;
---

<BaseLayout
  title="CLF-C02 Exam Coverage Map"
  description="Every CLF-C02 task statement from the AWS exam guide mapped to the lessons and practice questions that cover it, so nothing on the exam is missed."
>
  <p>
    <a href="/practice" class="t-mono-sm uppercase transition-colors hover:text-ink-1" style="color: var(--kicker-ink)">
      &larr; Back to practice
    </a>
  </p>

  <header class="mt-4 max-w-2xl">
    <p class="t-mono-sm mt-4 uppercase" style="color: var(--kicker-ink)">
      Coverage · the audit
    </p>
    <h1 class="t-page mt-3 text-ink-1">Exam coverage map</h1>
    <p class="t-body-lg mt-3 text-ink-2">
      All {totalStatements} task statements from the AWS Certified Cloud
      Practitioner (CLF-C02) exam guide, grouped by domain, each linked to the
      lessons and practice questions that cover it. Use it to study by the
      blueprint and confirm nothing on the exam is left uncovered.
    </p>
    <p class="t-mono-sm mt-3 uppercase text-ink-3">
      Domains weighted 24 / 30 / 34 / 12 of the scored exam
    </p>
  </header>

  <div class="mt-10 flex flex-col gap-10">
    {
      byDomain.map((group) => (
        <section>
          <div class="flex flex-wrap items-center gap-3 border-t border-line-1 pt-7">
            <DomainBadge domain={group.meta.id} showName={false} />
            <h2 class="t-title text-ink-1">{group.meta.name}</h2>
            <span class="t-mono-sm ml-auto uppercase text-ink-3">
              {group.meta.weight}% of the exam
            </span>
          </div>

          <ul class="mt-4 flex flex-col gap-4">
            {group.statements.map((s) => (
              <li class="rounded-r3 border border-line-1 bg-ground-1 p-4 sm:p-5">
                <div class="flex flex-wrap items-start gap-3.5">
                  <span class="t-mono pt-0.5 text-ink-3">{s.id}</span>
                  <h3 class="t-sub min-w-0 flex-1 text-ink-1">{s.title}</h3>
                  <span class="inline-flex flex-none items-center gap-1.5 whitespace-nowrap">
                    <svg width="13" height="13" viewBox="0 0 18 18" aria-hidden="true">
                      <circle cx="9" cy="9" r="6.6" fill="none" stroke="var(--ok)" stroke-width="1.6" />
                      <circle cx="9" cy="9" r="2.3" fill="var(--ok)" />
                    </svg>
                    <span class="font-mono text-[9.5px] tracking-[0.12em]" style="color: var(--ok)">COVERED</span>
                  </span>
                  <span class="t-mono-sm flex-none text-ink-3">{s.questionCount} Q</span>
                </div>

                <div class="mt-4">
                  <h4 class="sr-only">Lessons</h4>
                  <ul class="t-body-sm mt-1.5 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <li class="text-ink-3">Lessons:</li>
                    {s.lessons.map((lesson) => (
                      <li>
                        <a
                          href={`/learn/${lesson.slug}`}
                          class="border-b-2 border-dotted border-line-1 text-ink-2 transition-colors hover:text-ink-1"
                        >
                          {lesson.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="mt-4">
                  <h4 class="sr-only">Questions</h4>
                  <p class="t-body-sm mt-1.5 text-ink-2">
                    <a
                      href={`/practice/${s.domain}`}
                      class="border-b-2 border-dotted border-line-1 transition-colors hover:text-ink-1"
                    >
                      {s.questionCount} practice{" "}
                      {s.questionCount === 1 ? "question" : "questions"}
                    </a>{" "}
                    <span class="text-ink-3">
                      in {group.meta.name} practice.
                    </span>
                  </p>
                  <ul class="mt-2 flex flex-wrap gap-1.5">
                    {s.topics.map((topic) => (
                      <li class="rounded-r1 border border-line-1 px-2 py-0.5 font-mono text-[9px] uppercase tracking-[0.08em] text-ink-3">
                        {topic}
                      </li>
                    ))}
                  </ul>
                </div>

                <p class="mt-3.5">
                  <a
                    href={s.reference.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="t-mono-sm uppercase transition-colors hover:text-ink-1"
                    style="color: var(--kicker-ink)"
                  >
                    Exam guide &#8599;
                  </a>
                </p>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  {/* The audit's bottom line: one tick per task statement, all filled. */}
  <div
    class="mt-10 flex flex-wrap items-center gap-3.5 border-t border-line-1 pt-5"
  >
    <span
      class="flex gap-[3px]"
      role="img"
      aria-label={`${totalStatements} of ${totalStatements} task statements covered`}
    >
      {
        Array.from({ length: totalStatements }, () => (
          <span class="block h-1 w-2.5" style="background: var(--ok)" />
        ))
      }
    </span>
    <span
      class="font-mono text-[10.5px] tracking-[0.1em]"
      style="color: var(--ok)"
    >
      TASK STATEMENTS COVERED — {totalStatements} OF {totalStatements}
    </span>
    <span class="t-mono-sm ml-auto uppercase text-ink-3">
      {mappedQuestions} questions mapped
    </span>
  </div>
</BaseLayout>
