---
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource-variable/literata/opsz.css";
import "@fontsource-variable/literata/opsz-italic.css";
import "@fontsource-variable/sometype-mono/index.css";
import "@/styles/global.css";
import { getCollection } from "astro:content";
import { ALL_SERVICES } from "@/data/services";
import {
  NAV_TARGETS,
  buildLessonIndex,
  buildServiceIndex,
} from "@/lib/navigation";
import CommandPalette from "@/components/navigation/CommandPalette.tsx";
import ReloadPrompt from "@/components/pwa/ReloadPrompt.tsx";

interface Props {
  title: string;
  description?: string;
  /** Optional absolute or root-relative image for social cards. */
  image?: string;
  /** og:type; "website" for hub pages, "article" for lessons. */
  ogType?: string;
  /** Page-specific JSON-LD object(s), appended after the site-wide graph. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

// Build the command-palette search index at build time and hand it to the
// island as plain JSON props, so the palette ships with the lesson and service
// lists baked in and never fetches at runtime. Static per render; the same
// shared mappers the build-time gate uses, so the index can never drift from
// what the gate validates.
const allLessons = await getCollection("lessons");
const lessonIndex = buildLessonIndex(allLessons);
const serviceIndex = buildServiceIndex(ALL_SERVICES);

// The most recent verification stamp across the lesson bank, shown in the
// footer as the site-wide "facts verified" line.
const latestVerified = allLessons.reduce((max, l) => {
  const d = l.data.updated instanceof Date ? l.data.updated : new Date(l.data.updated);
  return d > max ? d : max;
}, new Date(0));
const verifiedLabel = latestVerified
  .toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" })
  .toUpperCase();

const {
  title,
  description = "Learn AWS and prepare for the Certified Cloud Practitioner exam with free lessons, practice questions, and full timed mock exams.",
  image = "/og.png",
  ogType = "website",
  jsonLd,
} = Astro.props;

const siteName = "Cloud Practitioner Prep";
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const year = new Date().getFullYear();

// Canonical and og:url resolve against the configured site. Astro.site is set
// in astro.config.mjs; the build warns if it is missing. The path is
// canonicalized without a trailing slash because every internal link and the
// service worker's precache use the slashless form; publishing the same form
// keeps an indexed URL on the exact path the app serves offline.
const pagePath =
  Astro.url.pathname.length > 1
    ? Astro.url.pathname.replace(/\/+$/, "")
    : Astro.url.pathname;
const canonical = Astro.site ? new URL(pagePath, Astro.site).href : pagePath;
const ogImage =
  image && Astro.site ? new URL(image, Astro.site).href : image;

// Structured data. The site-wide graph (a WebSite with a catalog search action
// and the publishing Organization) renders on every page; individual pages may
// pass page-specific JSON-LD (a Course, an FAQ, breadcrumbs) via the jsonLd
// prop. URLs are built by string join so the search-action template braces are
// not percent-encoded the way new URL() would encode them.
const siteUrl = Astro.site?.href ?? `${Astro.url.origin}/`;
const orgId = `${siteUrl}#org`;
const siteJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: siteName,
      description:
        "Free, open-source study site for the AWS Certified Cloud Practitioner exam (CLF-C02): lessons, original practice questions, and full timed mock exams.",
      inLanguage: "en",
      publisher: { "@id": orgId },
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: `${siteUrl}catalog?q={search_term_string}`,
        },
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "Organization",
      "@id": orgId,
      name: siteName,
      url: siteUrl,
      ...(ogImage ? { logo: ogImage } : {}),
    },
  ],
};
const pageJsonLd = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];

const nav = [
  { href: "/", label: "Home" },
  { href: "/learn", label: "Learn" },
  { href: "/practice", label: "Practice" },
  { href: "/catalog", label: "Catalog" },
  { href: "/coverage", label: "Coverage" },
  { href: "/progress", label: "Progress" },
  { href: "/about", label: "About" },
];

const path = Astro.url.pathname;
function isActive(href: string): boolean {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(`${href}/`);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/*
      The PWA manifest, theme color, and Apple touch icon are linked explicitly.
      The build emits manifest.webmanifest + the icons, but the integration's
      automatic head injection does not run on this Astro version, so these tags
      are declared here to make the app installable. The colors match the
      manifest (the brand theme color, the light surface as the icon backdrop).
    */}
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#efeade" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171511" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180x180.png" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {
      ogImage && (
        <meta
          property="og:image:alt"
          content="Cloud Practitioner Prep, free AWS Cloud Practitioner CLF-C02 lessons, practice questions, and mock exams"
        />
      )
    }
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
    {
      pageJsonLd.map((obj) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(obj)} />
      ))
    }
    {/* Apply the saved theme before paint so there is no flash of the wrong one. */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("ccp-prep:theme");
          var prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          if (saved === "dark" || (saved === null && prefersDark)) {
            document.documentElement.classList.add("dark");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-ground-0 text-ink-1">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-sm focus:bg-action focus:px-4 focus:py-2 focus:text-ink-inverse"
    >
      Skip to content
    </a>

    <header class="border-b border-line-1 bg-ground-0">
      <div
        class="mx-auto flex h-14 max-w-[1200px] items-center justify-between gap-3 px-[18px] sm:px-6 md:h-16 xl:px-12"
      >
        <a href="/" class="flex shrink-0 items-center gap-2.5 text-ink-1">
          <svg
            width="20"
            height="20"
            viewBox="0 0 56 56"
            aria-hidden="true"
            class="shrink-0"
          >
            <circle
              cx="28"
              cy="28"
              r="15"
              fill="none"
              stroke="currentColor"
              stroke-width="4"></circle>
            <circle cx="28" cy="28" r="5.5" fill="currentColor"></circle>
            <path
              d="M28 3v8M28 45v8M3 28h8M45 28h8"
              stroke="var(--blueprint)"
              stroke-width="4"
              stroke-linecap="round"></path>
          </svg>
          <span class="text-[16.5px] font-[640] tracking-[-0.01em]">
            Cloud Practitioner Prep
          </span>
        </a>

        {/* Desktop navigation: the active item carries an ink weight and a
            blueprint underline at the bar's base, never a filled pill. */}
        <nav aria-label="Primary" class="hidden md:block">
          <ul class="flex h-16 items-center gap-1">
            {
              nav.map((item) => (
                <li class="h-full">
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? "page" : undefined}
                    class:list={[
                      "flex h-full items-center border-b-[3px] px-3 text-[15px] transition-colors",
                      isActive(item.href)
                        ? "border-blueprint font-[620] text-ink-1"
                        : "border-transparent font-[520] text-ink-2 hover:text-ink-1",
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li class="ml-2">
              <button
                type="button"
                data-open-palette
                aria-label="Open search (Ctrl+K or Cmd+K)"
                class="t-mono-sm rounded-sm border border-line-1 px-2 py-1 text-ink-3 transition-colors hover:border-line-2 hover:text-ink-1"
              >
                &#8984;K
              </button>
            </li>
            <li>
              <button
                id="theme-toggle"
                type="button"
                aria-label="Switch theme"
                class="theme-toggle flex size-[30px] items-center justify-center rounded-full text-ink-2 transition-colors hover:text-ink-1"
              >
                <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
                  <circle
                    cx="9"
                    cy="9"
                    r="7"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"></circle>
                  <path d="M9 2a7 7 0 0 1 0 14Z" fill="currentColor"></path>
                </svg>
              </button>
            </li>
          </ul>
        </nav>

        {/* Below md the navigation is a full-screen index sheet, not wrapped
            links. */}
        <button
          type="button"
          id="index-open"
          aria-controls="index-sheet"
          aria-expanded="false"
          class="t-mono-label flex items-center gap-1.5 rounded-sm border border-line-1 px-2.5 py-1.5 text-ink-2 transition-colors hover:border-line-2 hover:text-ink-1 md:hidden"
        >
          <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
            <path
              d="M1 1h4v4H1zM7 1h4v4H7zM1 7h4v4H1zM7 7h4v4H7z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.2"></path>
          </svg>
          Index
        </button>
      </div>
    </header>

    {/* The mobile index sheet: route rows with survey indices, then theme and
        search controls. Hidden until opened; the script below owns the state. */}
    <div
      id="index-sheet"
      role="dialog"
      aria-modal="true"
      aria-label="Site index"
      hidden
      class="fixed inset-0 z-50 flex flex-col bg-ground-0 md:hidden"
    >
      <div class="flex h-14 items-center justify-between border-b border-line-1 px-[18px]">
        <span class="t-mono-label text-ink-3">Index</span>
        <button
          type="button"
          id="index-close"
          class="t-mono-label rounded-sm border border-line-1 px-2.5 py-1.5 text-ink-2 hover:text-ink-1"
        >
          Close
        </button>
      </div>
      <nav aria-label="Primary, index sheet" class="flex-1 overflow-y-auto px-[18px] py-2">
        <ul>
          {
            nav.map((item, i) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class:list={[
                    "flex h-14 items-center gap-4 border-b border-line-1",
                    isActive(item.href) ? "text-ink-1" : "text-ink-2",
                  ]}
                >
                  <span class="t-mono-sm w-6 text-ink-3">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  {isActive(item.href) && (
                    <span
                      aria-hidden="true"
                      class="h-[3px] w-4 bg-blueprint"
                    />
                  )}
                  <span class="text-[22px] font-[620] tracking-[-0.01em]">
                    {item.label}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="flex items-center justify-between border-t border-line-1 px-[18px] py-4">
        <button
          type="button"
          aria-label="Switch theme"
          class="theme-toggle flex items-center gap-2 text-ink-2 hover:text-ink-1"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
            <circle
              cx="9"
              cy="9"
              r="7"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"></circle>
            <path d="M9 2a7 7 0 0 1 0 14Z" fill="currentColor"></path>
          </svg>
          <span class="t-mono-label">Theme</span>
        </button>
        <button
          type="button"
          data-open-palette
          class="t-mono-label flex items-center gap-2 text-ink-2 hover:text-ink-1"
        >
          Search
          <span class="rounded-sm border border-line-1 px-1.5 py-0.5">&#8984;K</span>
        </button>
      </div>
    </div>

    <main id="main" class="mx-auto w-full max-w-[1200px] px-[18px] py-8 sm:px-6 sm:py-12 xl:px-12">
      <slot />
    </main>

    <footer class="mt-16 border-t border-line-1">
      <div
        class="mx-auto grid max-w-[1200px] gap-8 px-[18px] py-10 sm:px-6 md:grid-cols-[1fr_auto_auto] md:gap-12 xl:px-12"
      >
        <div class="t-body-sm max-w-[52ch] text-ink-3">
          <p>
            An independent, free study site for the AWS Certified Cloud
            Practitioner exam (CLF-C02). Not affiliated with, authorized by,
            sponsored by, or endorsed by Amazon Web Services. AWS, Amazon Web
            Services, and Certified Cloud Practitioner are trademarks of
            Amazon.com, Inc. or its affiliates.
          </p>
          <p class="mt-3">© {year} Abdalla Eldoumani</p>
        </div>
        <ul class="t-body-sm flex flex-col gap-2 text-ink-2">
          <li>
            <a href="/about" class="transition-colors hover:text-ink-1">
              About and sources
            </a>
          </li>
          <li>
            <a
              href="https://github.com/Abdalla-Eldoumani/cloud-practitioner-prep"
              rel="noopener"
              class="transition-colors hover:text-ink-1"
            >
              GitHub &#8599;
            </a>
          </li>
          <li>MIT licensed</li>
        </ul>
        <div class="flex items-start gap-2">
          <svg
            width="14"
            height="14"
            viewBox="0 0 18 18"
            aria-hidden="true"
            class="mt-px shrink-0"
          >
            <circle
              cx="9"
              cy="9"
              r="6.6"
              fill="none"
              stroke="var(--ink-3)"
              stroke-width="1.6"></circle>
            <circle cx="9" cy="9" r="2.3" fill="var(--ink-3)"></circle>
          </svg>
          <span class="t-mono-label text-ink-3">
            Facts verified · {verifiedLabel}
          </span>
        </div>
      </div>
    </footer>

    {/*
      The command palette and the shortcuts help, mounted once for every page so
      Cmd/Ctrl+K and "?" work site-wide. client:idle (not load): the palette is
      not needed at first paint, and the inline trigger below covers any keypress
      that lands before the island hydrates by dispatching an event the island
      replays on mount. The search index is computed above and passed as props.
    */}
    <CommandPalette
      client:idle
      routes={NAV_TARGETS}
      lessons={lessonIndex}
      services={serviceIndex}
    />

    {/*
      The reload prompt, mounted once for every page so a new version can surface
      anywhere as an opt-in reload — never an auto-reload that would interrupt an
      in-progress timed exam. client:idle (not load): it is not needed at first
      paint and only ever appears once a new version is waiting. It takes no
      props (it reads the service-worker registration itself). The manifest link,
      theme-color, and apple-touch-icon are declared explicitly in <head> above,
      because the build's automatic head injection does not run on this Astro
      version.
    */}
    <ReloadPrompt client:idle />

    {/*
      The global keyboard trigger. Runs on every page regardless of island
      hydration: it owns Cmd/Ctrl+K (open the palette) and "?" (open the help),
      dispatching a window event the island listens for. It is the only thing
      guaranteed present before hydration, so the shortcut never depends on the
      React island having loaded yet.

      Guards: "?" only fires when focus is NOT in a text field, so typing "?"
      into the palette's own search (or any input) inserts a literal "?" instead
      of reopening the help. Only the handled keys are preventDefault'd; the
      browser's native find (Ctrl/Cmd+F) is never bound or intercepted.
    */}
    <script is:inline>
      (function () {
        function isTypingTarget(el) {
          if (!el) return false;
          var tag = el.tagName;
          return (
            tag === "INPUT" ||
            tag === "TEXTAREA" ||
            tag === "SELECT" ||
            el.isContentEditable === true
          );
        }
        // A latch for the open intent. If a shortcut is pressed before the
        // client:idle island has hydrated and subscribed, the event alone would
        // be missed, so the latest intent is also recorded on a global the island
        // reads once on mount. The island clears it after replaying, so it only
        // ever fires for a keypress that genuinely preceded hydration.
        function signal(name) {
          window.__ccpPaletteIntent = name;
          window.dispatchEvent(new CustomEvent(name));
        }
        window.addEventListener("keydown", function (e) {
          if ((e.metaKey || e.ctrlKey) && (e.key === "k" || e.key === "K")) {
            e.preventDefault();
            signal("ccp:open-palette");
            return;
          }
          if (e.key === "?" && !isTypingTarget(document.activeElement)) {
            e.preventDefault();
            signal("ccp:open-help");
          }
        });
      })();
    </script>

    <script is:inline>
      (function () {
        var btns = document.querySelectorAll(".theme-toggle");
        for (var i = 0; i < btns.length; i++) {
          btns[i].addEventListener("click", function () {
            var isDark = document.documentElement.classList.toggle("dark");
            try {
              localStorage.setItem("ccp-prep:theme", isDark ? "dark" : "light");
            } catch (e) {}
          });
        }
      })();
    </script>

    {/*
      Header controls that reuse the palette's open signal, and the mobile
      index sheet. The sheet is plain DOM state: hidden attribute, an
      aria-expanded mirror on the opener, a scroll lock on the root element,
      and Escape to close. Links inside close it on activation so navigation
      feels immediate even when the next page is instant.
    */}
    <script is:inline>
      (function () {
        function openPalette() {
          window.__ccpPaletteIntent = "ccp:open-palette";
          window.dispatchEvent(new CustomEvent("ccp:open-palette"));
        }
        var triggers = document.querySelectorAll("[data-open-palette]");
        for (var i = 0; i < triggers.length; i++) {
          triggers[i].addEventListener("click", openPalette);
        }

        var sheet = document.getElementById("index-sheet");
        var open = document.getElementById("index-open");
        var close = document.getElementById("index-close");
        if (!sheet || !open || !close) return;

        function setOpen(next) {
          sheet.hidden = !next;
          open.setAttribute("aria-expanded", next ? "true" : "false");
          document.documentElement.classList.toggle("overflow-hidden", next);
          if (next) {
            close.focus();
          } else {
            open.focus();
          }
        }
        open.addEventListener("click", function () {
          setOpen(true);
        });
        close.addEventListener("click", function () {
          setOpen(false);
        });
        sheet.addEventListener("click", function (e) {
          var el = e.target;
          while (el && el !== sheet) {
            if (el.tagName === "A") {
              setOpen(false);
              return;
            }
            el = el.parentElement;
          }
        });
        window.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && !sheet.hidden) {
            e.preventDefault();
            setOpen(false);
          }
        });
      })();
    </script>
  </body>
</html>
