---
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource-variable/literata/opsz.css";
import "@fontsource-variable/literata/opsz-italic.css";
import "@fontsource-variable/sometype-mono/index.css";
import "@/styles/global.css";
import { getCollection } from "astro:content";
import { ALL_SERVICES } from "@/data/services";
import {
  NAV_TARGETS,
  buildLessonIndex,
  buildServiceIndex,
} from "@/lib/navigation";
import CommandPalette from "@/components/navigation/CommandPalette.tsx";
import ReloadPrompt from "@/components/pwa/ReloadPrompt.tsx";

interface Props {
  title: string;
  description?: string;
  /** Optional absolute or root-relative image for social cards. */
  image?: string;
  /** og:type; "website" for hub pages, "article" for lessons. */
  ogType?: string;
  /** Page-specific JSON-LD object(s), appended after the site-wide graph. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

// Build the command-palette search index at build time and hand it to the
// island as plain JSON props, so the palette ships with the lesson and service
// lists baked in and never fetches at runtime. Static per render; the same
// shared mappers the build-time gate uses, so the index can never drift from
// what the gate validates.
const lessonIndex = buildLessonIndex(await getCollection("lessons"));
const serviceIndex = buildServiceIndex(ALL_SERVICES);

const {
  title,
  description = "Learn AWS and prepare for the Certified Cloud Practitioner exam with free lessons, practice questions, and full timed mock exams.",
  image = "/og.png",
  ogType = "website",
  jsonLd,
} = Astro.props;

const siteName = "Cloud Practitioner Prep";
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const year = new Date().getFullYear();

// Canonical and og:url resolve against the configured site. Astro.site is set
// in astro.config.mjs; the build warns if it is missing.
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;
const ogImage =
  image && Astro.site ? new URL(image, Astro.site).href : image;

// Structured data. The site-wide graph (a WebSite with a catalog search action
// and the publishing Organization) renders on every page; individual pages may
// pass page-specific JSON-LD (a Course, an FAQ, breadcrumbs) via the jsonLd
// prop. URLs are built by string join so the search-action template braces are
// not percent-encoded the way new URL() would encode them.
const siteUrl = Astro.site?.href ?? `${Astro.url.origin}/`;
const orgId = `${siteUrl}#org`;
const siteJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: siteName,
      description:
        "Free, open-source study site for the AWS Certified Cloud Practitioner exam (CLF-C02): lessons, original practice questions, and full timed mock exams.",
      inLanguage: "en",
      publisher: { "@id": orgId },
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: `${siteUrl}catalog?q={search_term_string}`,
        },
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "Organization",
      "@id": orgId,
      name: siteName,
      url: siteUrl,
      ...(ogImage ? { logo: ogImage } : {}),
    },
  ],
};
const pageJsonLd = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];

const nav = [
  { href: "/", label: "Home" },
  { href: "/learn", label: "Learn" },
  { href: "/practice", label: "Practice" },
  { href: "/catalog", label: "Catalog" },
  { href: "/progress", label: "Progress" },
  { href: "/about", label: "About" },
];

const path = Astro.url.pathname;
function isActive(href: string): boolean {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(`${href}/`);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/*
      The PWA manifest, theme color, and Apple touch icon are linked explicitly.
      The build emits manifest.webmanifest + the icons, but the integration's
      automatic head injection does not run on this Astro version, so these tags
      are declared here to make the app installable. The colors match the
      manifest (the brand theme color, the light surface as the icon backdrop).
    */}
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#2a4fcb" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180x180.png" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {
      ogImage && (
        <meta
          property="og:image:alt"
          content="Cloud Practitioner Prep, free AWS Cloud Practitioner CLF-C02 lessons, practice questions, and mock exams"
        />
      )
    }
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
    {
      pageJsonLd.map((obj) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(obj)} />
      ))
    }
    {/* Apply the saved theme before paint so there is no flash of the wrong one. */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("ccp-prep:theme");
          var prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          if (saved === "dark" || (saved === null && prefersDark)) {
            document.documentElement.classList.add("dark");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-surface text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-brand focus:px-4 focus:py-2 focus:text-raised"
    >
      Skip to content
    </a>

    <header class="border-b border-hairline bg-raised">
      <div
        class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6"
      >
        <a href="/" class="text-lg font-bold tracking-tight text-ink">
          Cloud Practitioner Prep
        </a>
        <nav aria-label="Primary">
          <ul class="flex flex-wrap items-center justify-end gap-1 gap-y-2 text-sm">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? "page" : undefined}
                    class:list={[
                      "rounded-md px-3 py-1.5 font-medium transition-colors",
                      isActive(item.href)
                        ? "bg-info-soft text-brand"
                        : "text-ink-soft hover:text-ink",
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <button
                id="theme-toggle"
                type="button"
                aria-label="Toggle dark mode"
                class="rounded-md border border-hairline px-2.5 py-1.5 text-ink-soft transition-colors hover:text-ink"
              >
                <span class="dark:hidden">Dark</span>
                <span class="hidden dark:inline">Light</span>
              </button>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
      <slot />
    </main>

    <footer class="mt-12 border-t border-hairline bg-raised">
      <div
        class="mx-auto max-w-5xl px-4 py-8 text-sm text-ink-soft sm:px-6"
      >
        <p class="max-w-prose">
          This is an independent, open-source study project that anyone can
          self-host. It is not affiliated with, authorized by, sponsored by, or
          endorsed by Amazon Web Services. AWS, Amazon Web Services, and
          Certified Cloud Practitioner are trademarks of Amazon.com, Inc. or its
          affiliates.
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
          <span>© {year} Abdalla Eldoumani</span>
          <a href="/about" class="underline underline-offset-2 hover:text-ink">
            About and sources
          </a>
          <span>MIT licensed</span>
        </div>
      </div>
    </footer>

    {/*
      The command palette and the shortcuts help, mounted once for every page so
      Cmd/Ctrl+K and "?" work site-wide. client:idle (not load): the palette is
      not needed at first paint, and the inline trigger below covers any keypress
      that lands before the island hydrates by dispatching an event the island
      replays on mount. The search index is computed above and passed as props.
    */}
    <CommandPalette
      client:idle
      routes={NAV_TARGETS}
      lessons={lessonIndex}
      services={serviceIndex}
    />

    {/*
      The reload prompt, mounted once for every page so a new version can surface
      anywhere as an opt-in reload — never an auto-reload that would interrupt an
      in-progress timed exam. client:idle (not load): it is not needed at first
      paint and only ever appears once a new version is waiting. It takes no
      props (it reads the service-worker registration itself). The manifest link,
      theme-color, and apple-touch-icon are declared explicitly in <head> above,
      because the build's automatic head injection does not run on this Astro
      version.
    */}
    <ReloadPrompt client:idle />

    {/*
      The global keyboard trigger. Runs on every page regardless of island
      hydration: it owns Cmd/Ctrl+K (open the palette) and "?" (open the help),
      dispatching a window event the island listens for. It is the only thing
      guaranteed present before hydration, so the shortcut never depends on the
      React island having loaded yet.

      Guards: "?" only fires when focus is NOT in a text field, so typing "?"
      into the palette's own search (or any input) inserts a literal "?" instead
      of reopening the help. Only the handled keys are preventDefault'd; the
      browser's native find (Ctrl/Cmd+F) is never bound or intercepted.
    */}
    <script is:inline>
      (function () {
        function isTypingTarget(el) {
          if (!el) return false;
          var tag = el.tagName;
          return (
            tag === "INPUT" ||
            tag === "TEXTAREA" ||
            tag === "SELECT" ||
            el.isContentEditable === true
          );
        }
        // A latch for the open intent. If a shortcut is pressed before the
        // client:idle island has hydrated and subscribed, the event alone would
        // be missed, so the latest intent is also recorded on a global the island
        // reads once on mount. The island clears it after replaying, so it only
        // ever fires for a keypress that genuinely preceded hydration.
        function signal(name) {
          window.__ccpPaletteIntent = name;
          window.dispatchEvent(new CustomEvent(name));
        }
        window.addEventListener("keydown", function (e) {
          if ((e.metaKey || e.ctrlKey) && (e.key === "k" || e.key === "K")) {
            e.preventDefault();
            signal("ccp:open-palette");
            return;
          }
          if (e.key === "?" && !isTypingTarget(document.activeElement)) {
            e.preventDefault();
            signal("ccp:open-help");
          }
        });
      })();
    </script>

    <script is:inline>
      (function () {
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        btn.addEventListener("click", function () {
          var isDark = document.documentElement.classList.toggle("dark");
          try {
            localStorage.setItem("ccp-prep:theme", isDark ? "dark" : "light");
          } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
