---
import type { MarkdownHeading } from "astro";
import type { Domain } from "@/lib/types";
import BaseLayout from "./BaseLayout.astro";
import LessonComplete from "@/components/LessonComplete.tsx";
import { domainName } from "@/lib/constants";

interface NavLink {
  slug: string;
  title: string;
}

interface ChainLink {
  slug: string;
  title: string;
  minutes: number;
}

interface Props {
  title: string;
  description: string;
  domain: Domain;
  module: number;
  estimatedMinutes: number;
  updated: Date;
  services: string[];
  slug: string;
  prev: NavLink | null;
  next: NavLink | null;
  // 1-based position in the canonical reading order, and the library size.
  index: number;
  total: number;
  // The domain's own lessons in order, for the right-rail chain.
  domainLessons: ChainLink[];
  // The lesson's h2 headings, for the IN THIS LESSON anchors.
  headings: MarkdownHeading[];
}

const {
  title,
  description,
  domain,
  estimatedMinutes,
  updated,
  services,
  slug,
  prev,
  next,
  index,
  total,
  domainLessons,
  headings,
} = Astro.props;

const verifiedLabel = updated
  .toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" })
  .toUpperCase();
const anchors = headings.filter((h) => h.depth === 2);
const nn = (n: number) => String(n).padStart(2, "0");

// Structured data for this lesson: a free LearningResource that is part of the
// CLF-C02 course, plus a breadcrumb trail. URLs resolve against the configured
// site; dateModified is the last-verified date.
const siteUrl = Astro.site?.href ?? `${Astro.url.origin}/`;
const lessonUrl = `${siteUrl}learn/${slug}/`;
const lessonJsonLd = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  name: title,
  description,
  url: lessonUrl,
  inLanguage: "en",
  isAccessibleForFree: true,
  learningResourceType: "lesson",
  educationalLevel: "Beginner",
  timeRequired: `PT${estimatedMinutes}M`,
  about: "AWS Certified Cloud Practitioner (CLF-C02)",
  teaches: services,
  dateModified: updated.toISOString().slice(0, 10),
  isPartOf: {
    "@type": "Course",
    name: "AWS Certified Cloud Practitioner (CLF-C02) Study Course",
    "@id": `${siteUrl}learn/#course`,
  },
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
    { "@type": "ListItem", position: 2, name: "Lessons", item: `${siteUrl}learn/` },
    { "@type": "ListItem", position: 3, name: title, item: lessonUrl },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  jsonLd={[lessonJsonLd, breadcrumbJsonLd]}
>
  <div class="mx-auto flex max-w-[1024px] justify-center gap-16">
    <article class="w-full min-w-0 max-w-[660px]">
      {/* Breadcrumb: wayfinding in the measuring voice. */}
      <div
        class="flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono text-[11px] text-ink-3"
      >
        <a
          href="/learn"
          class="text-ink-2 transition-colors hover:text-ink-1"
          >LEARN</a
        >
        <span aria-hidden="true">/</span>
        <span class="inline-flex items-center gap-1.5">
          <svg width="9" height="9" viewBox="0 0 11 11" aria-hidden="true">
            {
              domain === 1 && (
                <circle
                  cx="5.5"
                  cy="5.5"
                  r="4.2"
                  fill="none"
                  stroke="var(--d1)"
                  stroke-width="1.6"
                />
              )
            }
            {
              domain === 2 && (
                <rect
                  x="2.4"
                  y="2.4"
                  width="6.2"
                  height="6.2"
                  fill="none"
                  stroke="var(--d2)"
                  stroke-width="1.6"
                  transform="rotate(45 5.5 5.5)"
                />
              )
            }
            {
              domain === 3 && (
                <polygon
                  points="2,2.6 9,2.6 5.5,9"
                  fill="none"
                  stroke="var(--d3)"
                  stroke-width="1.6"
                  stroke-linejoin="round"
                />
              )
            }
            {
              domain === 4 && (
                <rect
                  x="2.2"
                  y="2.2"
                  width="6.6"
                  height="6.6"
                  fill="none"
                  stroke="var(--d4)"
                  stroke-width="1.6"
                />
              )
            }
          </svg>
          <span style={`color: var(--d${domain})`}>
            D{domain}<span class="hidden sm:inline">
              · {domainName(domain).toUpperCase()}</span
            >
          </span>
        </span>
        <span class="ml-auto"
          >LESSON {nn(index)} / {total} · {estimatedMinutes} MIN</span
        >
      </div>

      <h1 class="t-page mt-5 text-ink-1">{title}</h1>
      <p
        class="mt-3.5 font-mono text-[10.5px] tracking-[0.1em] text-ink-3 uppercase"
      >
        Facts last verified — {verifiedLabel}
        {
          services.length > 0 && (
            <span> · Covers {services.slice(0, 4).join(" · ")}</span>
          )
        }
      </p>

      <div class="prose prose-lesson dark:prose-invert mt-7 max-w-none">
        <slot />
      </div>

      {/* Mark complete: fixing the station. */}
      <div
        class="mt-9 flex flex-wrap items-center gap-3.5 border-t border-line-1 pt-6"
      >
        <LessonComplete client:visible slug={slug} />
        <span class="t-mono-sm hidden uppercase text-ink-3 sm:inline">
          Fixes station {nn(index)} · the chain advances on learn + home
        </span>
      </div>

      <nav aria-label="Lesson navigation" class="mt-6 grid gap-3 sm:grid-cols-2">
        {
          prev ? (
            <a
              href={`/learn/${prev.slug}`}
              class="rounded-r3 border border-line-1 bg-ground-1 px-4.5 py-4 transition-colors hover:border-line-2"
            >
              <span class="font-mono text-[9.5px] tracking-[0.14em] text-ink-3">
                &larr; PREVIOUS · {nn(index - 1)}
              </span>
              <span class="t-sub mt-1.5 block text-ink-1">{prev.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a
              href={`/learn/${next.slug}`}
              class="rounded-r3 border border-line-1 bg-ground-1 px-4.5 py-4 text-right transition-colors hover:border-line-2 sm:col-start-2"
            >
              <span class="font-mono text-[9.5px] tracking-[0.14em] text-ink-3">
                NEXT · {nn(index + 1)} &rarr;
              </span>
              <span class="t-sub mt-1.5 block text-ink-1">{next.title}</span>
            </a>
          )
        }
      </nav>
    </article>

    {/* Right rail at 1200+: the domain's chain, then the lesson's anchors. */}
    <aside class="hidden w-[300px] flex-none min-[1200px]:block">
      <div class="sticky top-8">
        <div class="rounded-r3 border border-line-1 bg-ground-1 px-5 py-4.5">
          <p
            class="t-mono-label"
            style="color: var(--kicker-ink)"
            data-chain-head
          >
            D{domain} — the chain
          </p>
          <div class="mt-3 flex flex-col">
            {
              domainLessons.map((l, i) => (
                <>
                  {i > 0 && (
                    <span
                      aria-hidden="true"
                      class="ml-[7px] h-3.5 border-l-2 border-dotted"
                      style="border-color: color-mix(in srgb, var(--blueprint) 40%, transparent)"
                    />
                  )}
                  <div
                    class="flex items-center gap-3 py-1.5"
                    data-lesson={l.slug}
                    data-state={l.slug === slug ? "current" : "open"}
                  >
                    <span class="relative flex size-[15px] flex-none items-center justify-center">
                      {l.slug === slug && (
                        <svg
                          width="23"
                          height="23"
                          viewBox="0 0 30 30"
                          aria-hidden="true"
                          class="absolute -top-1 -left-1"
                        >
                          <path
                            d="M2 8.5V2h6.5M21.5 2H28v6.5M28 21.5V28h-6.5M8.5 28H2v-6.5"
                            fill="none"
                            stroke="var(--blueprint)"
                            stroke-width="2.4"
                            stroke-linecap="round"
                          />
                        </svg>
                      )}
                      <svg
                        width="15"
                        height="15"
                        viewBox="0 0 18 18"
                        aria-hidden="true"
                      >
                        <circle
                          cx="9"
                          cy="9"
                          r="6.6"
                          fill="none"
                          stroke={
                            l.slug === slug ? "var(--ink-1)" : "var(--ink-3)"
                          }
                          stroke-width="1.6"
                        />
                        <circle
                          data-when="done"
                          cx="9"
                          cy="9"
                          r="2.3"
                          fill="var(--ink-1)"
                        />
                      </svg>
                    </span>
                    {l.slug === slug ? (
                      <span class="text-[13px] font-[620] text-ink-1">
                        {l.title}
                      </span>
                    ) : (
                      <a
                        href={`/learn/${l.slug}`}
                        class="text-[13px] text-ink-2 transition-colors hover:text-ink-1"
                      >
                        {l.title}
                      </a>
                    )}
                    <span class="t-mono-sm ml-auto flex-none text-ink-3">
                      {l.minutes}'
                    </span>
                  </div>
                </>
              ))
            }
          </div>
        </div>

        {
          anchors.length > 0 && (
            <div class="mt-6 border-l-[3px] border-ground-2 py-0.5 pl-4">
              <p class="t-mono-label text-ink-3">In this lesson</p>
              <nav aria-label="In this lesson">
                <ul class="mt-2.5 flex flex-col gap-2">
                  {anchors.map((h) => (
                    <li>
                      <a
                        href={`#${h.slug}`}
                        class="text-[13px] text-ink-2 transition-colors hover:text-ink-1"
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>
          )
        }
      </div>
    </aside>
  </div>

  {/* Mark the domain chain's fixed stations from saved progress. */}
  <script is:inline>
    (function () {
      try {
        var raw = localStorage.getItem("ccp-prep:progress:v1");
        if (!raw) return;
        var done = new Set(JSON.parse(raw).completedLessons || []);
        var fixed = 0;
        var rows = document.querySelectorAll("[data-lesson]");
        rows.forEach(function (el) {
          if (done.has(el.getAttribute("data-lesson"))) {
            if (el.getAttribute("data-state") !== "current") {
              el.setAttribute("data-state", "done");
            }
            fixed += 1;
          }
        });
        var head = document.querySelector("[data-chain-head]");
        if (head && rows.length > 0) {
          head.textContent =
            head.textContent.trim() +
            " · " +
            fixed +
            " OF " +
            rows.length +
            " FIXED";
        }
      } catch (e) {}
    })();
  </script>
</BaseLayout>
