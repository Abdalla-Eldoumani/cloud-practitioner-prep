---
import type { StudyDay } from "@/data/study-plan";

// One day of the plan: a chain node (station or benchmark) plus a T2 card.
// Server-rendered in the cold state (day 1 current, the rest open); the home
// page's inline script re-marks nodes and cards from saved progress through
// the shared data-state contract. Mock days keep their benchmark triangle in
// every state and carry the flag chip.

interface Props {
  day: StudyDay;
  // All lessons that currently exist, so the title links a real page.
  lessons: { slug: string; title: string }[];
}

const { day, lessons } = Astro.props;

const bySlug = new Set(lessons.map((l) => l.slug));
const available = day.lessonSlugs.filter((s) => bySlug.has(s));
const pendingCount = day.lessonSlugs.length - available.length;
// A day with no lesson of its own is a practice day (day 7 is review and mocks),
// so the title goes to the practice hub rather than back to the lesson library.
const href = available.length > 0 ? `/learn/${available[0]}` : "/practice";
const isMock = !!day.milestone;
const mockLabel = day.day === 7 ? "MOCK 2·3" : "MOCK 1";
const domainLabel = day.focus.length > 1 ? "ALL" : `D${day.focus[0]}`;
const domainColor =
  day.focus.length > 1 ? "var(--ink-2)" : `var(--d${day.focus[0]})`;
const initialState = day.day === 1 ? "current" : "open";
---

<div
  class="flex items-start gap-3.5 md:flex-col md:items-center"
  data-day={day.day}
  data-day-lessons={available.join(",")}
  data-state={initialState}
>
  <span
    class="relative z-[1] flex size-8 flex-none items-center justify-center bg-ground-0"
  >
    <span aria-hidden="true" class="absolute inset-0" data-when="current">
      <svg width="32" height="32" viewBox="0 0 32 32">
        <path
          d="M2 9V2h7M23 2h7v7M30 23v7h-7M9 30H2v-7"
          fill="none"
          stroke="var(--blueprint)"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </span>
    {
      isMock ? (
        <svg width="19" height="19" viewBox="0 0 18 18" aria-hidden="true">
          <polygon
            points="9,2.5 16.5,15.5 1.5,15.5"
            fill="var(--ground-0)"
            stroke="var(--flag)"
            stroke-width="1.6"
            stroke-linejoin="round"
          />
          <circle cx="9" cy="11.6" r="1.8" fill="var(--flag)" />
        </svg>
      ) : (
        <svg width="19" height="19" viewBox="0 0 18 18" aria-hidden="true">
          <circle
            cx="9"
            cy="9"
            r="6.6"
            fill="var(--ground-0)"
            stroke="var(--ink-3)"
            stroke-width="1.6"
          />
          <circle data-when="done" cx="9" cy="9" r="2.3" fill="var(--ink-1)" />
        </svg>
      )
    }
  </span>

  <div
    class="flex min-h-[120px] w-full flex-1 flex-col gap-2 rounded-r3 border border-line-1 bg-ground-1 px-4 py-3.5"
  >
    <span
      class="flex items-center gap-2 font-mono text-[10.5px] tracking-[0.12em] text-ink-3"
    >
      DAY {String(day.day).padStart(2, "0")}
      {
        isMock && (
          <span
            class="rounded-r1 border px-1.5 py-px text-[9.5px] tracking-[0.1em] whitespace-nowrap"
            style="color: var(--flag); border-color: var(--flag-line)"
          >
            {mockLabel}
          </span>
        )
      }
      <span class="ml-auto whitespace-nowrap md:hidden">
        {day.targetMinutes} MIN
      </span>
    </span>
    <a
      href={href}
      class="t-sub text-ink-1 transition-colors hover:text-blueprint-strong"
      style="text-wrap: balance"
    >
      {day.title}
    </a>
    <span class="mt-auto flex items-center gap-2">
      <span class="t-mono-sm hidden text-ink-3 md:inline">
        {day.targetMinutes} MIN
      </span>
      <span
        class="t-mono-sm ml-auto"
        style={`color: ${domainColor}`}
        aria-label={`Focus: ${domainLabel}`}
      >
        {domainLabel}
      </span>
    </span>
    {
      pendingCount > 0 && (
        <span class="font-mono text-[9.5px] tracking-[0.1em] text-ink-3">
          +{pendingCount} IN WRITING
        </span>
      )
    }
    <span
      data-when="done"
      class="font-mono text-[10px] tracking-[0.14em]"
      style="color: var(--ok)"
    >
      ✓ FIXED
    </span>
    <span
      data-when="current"
      class="font-mono text-[10px] tracking-[0.14em] text-blueprint-strong"
    >
      UP NEXT &rarr;
    </span>
  </div>
</div>
