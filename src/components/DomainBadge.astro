---
import type { Domain } from "@/lib/types";
import { domainName } from "@/lib/constants";

interface Props {
  domain: Domain;
  showName?: boolean;
}

const { domain, showName = true } = Astro.props;

// The domain badge chip: the domain color carries the tint (40% border,
// 10% fill, colored text — the light-theme domain values are AA-darkened at
// the token level), and the D-number and name carry the meaning, so color is
// never the only signal.
const name = domainName(domain);
---

<span
  class="t-mono-sm inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 uppercase"
  style={`color: var(--d${domain}); border-color: color-mix(in srgb, var(--d${domain}) 40%, transparent); background: color-mix(in srgb, var(--d${domain}) 10%, transparent)`}
>
  <span class="font-[620]">D{domain}</span>
  {showName && <span>{name}</span>}
</span>
