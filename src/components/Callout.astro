---
// The two lesson callouts, and only two: NOTE (structure speaking — blueprint
// rule on the explanation ground) and EXAM TIP (the flag family with its
// pennant). Legacy MDX types map onto them: key/note read as NOTE, tip/warning
// as EXAM TIP. Body text is the reflection voice (Literata). Never stack two
// callouts adjacently in content.
interface Props {
  type?: "key" | "note" | "tip" | "warning";
  title?: string;
}

const { type = "note", title } = Astro.props;

const isTip = type === "tip" || type === "warning";
const heading = title ?? (isTip ? "Exam tip" : "Note");
---

<aside
  class="not-prose my-6 rounded-r-r2 border-l-[3px] px-5 py-4"
  style={isTip
    ? "background: var(--flag-fill); border-color: var(--flag)"
    : "background: var(--ground-2); border-color: var(--blueprint)"}
>
  <p
    class="t-mono-label m-0 inline-flex items-center gap-2"
    style={isTip ? "color: var(--flag)" : "color: var(--kicker-ink)"}
  >
    {
      isTip && (
        <svg
          width="11"
          height="11"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3.5 14.5V2.5"></path>
          <path d="M3.5 3h8.5l-2.2 2.8L12 8.5H3.5"></path>
        </svg>
      )
    }
    {heading}
  </p>
  <div class="t-note mt-2 text-ink-2 [&_p]:m-0 [&_p+p]:mt-2">
    <slot />
  </div>
</aside>
