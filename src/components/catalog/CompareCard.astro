---
import type { CompareGroup } from "@/lib/types";
import { serviceById } from "@/data/services";

// A DON'T CONFUSE instrument: the services the exam loves to swap, laid out
// on one comparison table. Mono column heads carry the service names; under
// 768 the first column pins and the table scrolls inside its own border,
// never the page.
interface Props {
  group: CompareGroup;
}

const { group } = Astro.props;

// Resolve each member once so its name and domain stay single-sourced from the
// catalog. Unknown ids are dropped defensively, though the catalog lint already
// guarantees every serviceId resolves.
const members = group.serviceIds
  .map((id) => serviceById(id))
  .filter((s): s is NonNullable<typeof s> => s !== undefined);
---

<div
  id={group.id}
  class="relative scroll-mt-8 rounded-r3 border border-line-1 bg-ground-1 p-4 sm:p-5"
>
  <span
    aria-hidden="true"
    class="absolute -top-px -left-px size-3 border-t-2 border-l-2 border-blueprint"
  ></span>
  <span
    aria-hidden="true"
    class="absolute -top-px -right-px size-3 border-t-2 border-r-2 border-blueprint"
  ></span>
  <span
    aria-hidden="true"
    class="absolute -bottom-px -left-px size-3 border-b-2 border-l-2 border-blueprint"
  ></span>
  <span
    aria-hidden="true"
    class="absolute -bottom-px -right-px size-3 border-b-2 border-r-2 border-blueprint"
  ></span>

  <div class="flex flex-wrap items-center gap-2.5">
    <h3 class="t-mono-label" style="color: var(--kicker-ink)">
      Don't confuse — {group.title}
    </h3>
    <span
      class="ml-auto rounded-r1 border px-2 py-0.5 font-mono text-[9px] tracking-[0.12em] whitespace-nowrap"
      style="color: var(--flag); border-color: var(--flag-line)"
    >
      EXAM FAVORITE
    </span>
  </div>
  <p class="t-body-sm mt-1.5 text-ink-2">{group.framing}</p>

  <div class="mt-3.5 overflow-x-auto rounded-r2 border border-line-1">
    <table class="w-full min-w-[560px] border-collapse text-left">
      <thead>
        <tr class="border-b border-line-1">
          <th scope="col" class="sticky left-0 bg-ground-1 p-3 align-bottom">
            <span class="sr-only">Attribute</span>
          </th>
          {
            members.map((service) => (
              <th scope="col" class="p-3 align-bottom">
                <span class="flex items-baseline gap-2">
                  <span class="font-mono text-[12px] font-[560] text-ink-1">
                    {service.name}
                  </span>
                  <span
                    class="font-mono text-[9px] tracking-[0.1em]"
                    style={`color: var(--d${service.domain})`}
                  >
                    D{service.domain}
                  </span>
                </span>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          group.rows.map((row) => (
            <tr class="border-b border-line-1 last:border-0">
              <th
                scope="row"
                class="sticky left-0 bg-ground-1 p-3 align-top font-mono text-[10px] tracking-[0.12em] text-ink-3 uppercase"
              >
                {row.axis}
              </th>
              {members.map((service) => (
                <td class="t-body-sm p-3 align-top text-ink-2">
                  {row.cells[service.id]}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>
