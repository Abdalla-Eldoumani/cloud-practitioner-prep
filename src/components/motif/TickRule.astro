---
// TickRule: n small bars, one per counted unit; done ticks fill with ink.
// Always bound to a real count (lessons, statements, cards), never texture.
interface Props {
  count: number;
  done?: number;
  width?: number;
  height?: number;
  label?: string;
}
const { count, done = 0, width = 13, height = 3, label } = Astro.props;
const dim = "color-mix(in srgb, var(--blueprint) 34%, transparent)";
---

<span
  class="inline-flex flex-wrap gap-1"
  role="img"
  aria-label={label ?? `${done} of ${count}`}
>
  {
    Array.from({ length: count }).map((_, i) => (
      <span
        style={`width:${width}px;height:${height}px;display:block;background:${i < done ? "var(--ink-1)" : dim}`}
      />
    ))
  }
</span>
