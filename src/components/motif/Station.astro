---
// Station: the core survey glyph. A point on the learner's route.
// open = not yet visited (muted ring), fixed = done (ring plus center dot),
// current = where they stand (ring inside reticle corner brackets).
interface Props {
  state?: "open" | "fixed" | "current";
  size?: number;
  class?: string;
}
const { state = "open", size = 18, class: className } = Astro.props;
const stroke = state === "open" ? "var(--ink-3)" : "var(--ink-1)";
const box = `${size + 14}px`;
---

<span
  class:list={["relative inline-flex items-center justify-center", className]}
  style={`width:${box};height:${box}`}
>
  {
    state === "current" && (
      <svg
        width={size + 14}
        height={size + 14}
        viewBox="0 0 32 32"
        aria-hidden="true"
        class="absolute inset-0"
      >
        <path
          d="M2 9V2h7M23 2h7v7M30 23v7h-7M9 30H2v-7"
          fill="none"
          stroke="var(--blueprint)"
          stroke-width="2"
          stroke-linecap="round"
        />
      </svg>
    )
  }
  <svg width={size} height={size} viewBox="0 0 18 18" aria-hidden="true">
    <circle
      cx="9"
      cy="9"
      r="6.6"
      fill="var(--ground-0)"
      stroke={stroke}
      stroke-width="1.6"
    />
    {state === "fixed" && <circle cx="9" cy="9" r="2.3" fill="var(--ink-1)" />}
  </svg>
</span>
